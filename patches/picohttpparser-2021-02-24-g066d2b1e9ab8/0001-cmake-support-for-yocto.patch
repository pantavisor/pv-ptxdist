From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alexander Sack <asac@pantacor.com>
Date: Thu, 20 Apr 2023 04:06:39 -0400
Subject: [PATCH] cmake support for yocto

Signed-off-by: Fernando Luiz Cola <fernando.luiz@pantacor.com>
---
 CMakeLists.txt | 15 +++++++++++++++
 1 file changed, 15 insertions(+)
 create mode 100644 CMakeLists.txt

diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000..a7cc85d
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,15 @@
+cmake_minimum_required(VERSION 3.10)
+
+project(picohttpparser)
+
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED True)
+
+add_library(picohttpparser STATIC  picohttpparser.c)
+
+install(TARGETS picohttpparser
+        LIBRARY DESTINATION lib)
+
+install(FILES picohttpparser.h
+        DESTINATION include)
+
