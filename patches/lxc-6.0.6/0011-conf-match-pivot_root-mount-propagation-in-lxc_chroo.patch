From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alexander Sack <alexander.sack@pantacor.com>
Date: Fri, 16 Oct 2026 12:29:29 +0000
Subject: [PATCH] conf: match pivot_root mount propagation in lxc_chroot

lxc_chroot() made the whole tree private, dropping the propagation the
rootfs and lxc.mount.entry lines asked for. Keep it, as lxc_pivot_root()
does, and only make the old tree slave before it is unmounted.

Signed-off-by: Alexander Sack <alexander.sack@pantacor.com>
---
 src/lxc/conf.c | 23 +++++++++++++++++++++--
 1 file changed, 21 insertions(+), 2 deletions(-)

diff --git a/src/lxc/conf.c b/src/lxc/conf.c
index c0bd87699..98232c38a 100644
--- a/src/lxc/conf.c
+++ b/src/lxc/conf.c
@@ -1270,9 +1270,21 @@ static int lxc_chroot(const struct lxc_rootfs *rootfs)
 	if (ret < 0)
 		return log_error_errno(-1, errno, "Failed to mount \"%s\" onto \"/\" as MS_REC | MS_BIND", nroot);
 
-	ret = mount(NULL, "/", NULL, MS_REC | MS_PRIVATE, NULL);
+	/*
+	 * The copy on "/" keeps the propagation the rootfs and the mount
+	 * entries were set up with, as with pivot_root(). Turn the old root
+	 * and the old rootfs into dependent mounts instead, so cleaning them
+	 * up below propagates neither to the host nor into the copy. "/"
+	 * still resolves to the old root here and MS_REC on it would also
+	 * reach the copy.
+	 */
+	ret = mount(NULL, "/", NULL, MS_SLAVE, NULL);
+	if (ret < 0)
+		return log_error_errno(-1, errno, "Failed to turn old root into dependent mount");
+
+	ret = mount(NULL, nroot, NULL, MS_SLAVE | MS_REC, NULL);
 	if (ret < 0)
-		return log_error_errno(-1, errno, "Failed to remount \"/\"");
+		return log_error_errno(-1, errno, "Failed to recursively turn \"%s\" into dependent mount", nroot);
 
 	/* The following code cleans up inherited mounts which are not required
 	 * for CT.
@@ -1318,6 +1330,7 @@ static int lxc_chroot(const struct lxc_rootfs *rootfs)
 			if (strnequal(slider1 + 1, "/exports", 8))
 				continue;
 
+			(void)mount(NULL, slider1, NULL, MS_SLAVE | MS_REC, NULL);
 			ret = umount2(slider1, MNT_DETACH);
 			if (ret == 0)
 				progress++;
@@ -1328,6 +1341,7 @@ static int lxc_chroot(const struct lxc_rootfs *rootfs)
 	}
 
 	/* This also can be skipped if a container uses userns. */
+	(void)mount(NULL, "./proc", NULL, MS_SLAVE | MS_REC, NULL);
 	(void)umount2("./proc", MNT_DETACH);
 
 	/* It is weird, but chdir("..") moves us in a new root */
@@ -1339,6 +1353,11 @@ static int lxc_chroot(const struct lxc_rootfs *rootfs)
 	if (ret < 0)
 		return log_error_errno(-1, errno, "Failed to chroot(\".\")");
 
+	/* Same as lxc_pivot_root(): the rootfs becomes its own peer group. */
+	ret = mount("", "/", "", MS_SHARED | MS_REC, NULL);
+	if (ret < 0)
+		return log_error_errno(-1, errno, "Failed to turn new root mount tree into shared mount tree");
+
 	return 0;
 }
 
