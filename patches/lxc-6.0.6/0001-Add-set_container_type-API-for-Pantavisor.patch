+++ b/src/lxc/conf.c
@@ -4386,6 +4386,7 @@ void lxc_conf_free(struct lxc_conf *conf)
 	free(conf->cgroup_meta.systemd_scope);
 	free(conf->shmount.path_host);
 	free(conf->shmount.path_cont);
+	free(conf->type);
 	free(conf);
 }
 
diff --git a/src/lxc/conf.h b/src/lxc/conf.h
