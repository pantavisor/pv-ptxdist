 src/lxc/conf.h         |  3 ++
 src/lxc/log.c          | 81 ++++++++++++++++++++++++++++++++++++++++++
 src/lxc/log.h          |  1 +
 src/lxc/lxccontainer.c | 17 +++++++++
 src/lxc/lxccontainer.h | 19 ++++++++++
 src/lxc/start.c        | 15 +++++---
 7 files changed, 132 insertions(+), 5 deletions(-)

