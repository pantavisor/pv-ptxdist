From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alexander Sack <alexander.sack@pantacor.com>
Date: Thu, 5 Nov 2026 09:50:25 +0000
Subject: [PATCH] confile: add lxc.tty.min as lower bound of tty allocation

The 3.0 branch had this key only as a recipe patch, so the rebase to 6.0
dropped it and a config with lxc.tty.min failed to load.

With lxc.tty.min = 3 and lxc.tty.max = 6, only /dev/tty4 to /dev/tty6
are made container ttys and /dev/tty1 to /dev/tty3 are left alone. The
default of 0 behaves as before. A min that is not below max sets up no
ttys. A console request for a tty at or below min is refused.

Signed-off-by: Alexander Sack <alexander.sack@pantacor.com>
---
 doc/lxc.container.conf.sgml.in | 14 ++++++++++++
 src/lxc/conf.c                 | 33 +++++++++++++++-------------
 src/lxc/conf.h                 |  4 +++-
 src/lxc/confile.c              | 39 ++++++++++++++++++++++++++++++++++
 src/lxc/terminal.c             |  6 +++---
 5 files changed, 77 insertions(+), 19 deletions(-)

diff --git a/doc/lxc.container.conf.sgml.in b/doc/lxc.container.conf.sgml.in
index 20ae63fd4..7a91cc41a 100644
--- a/doc/lxc.container.conf.sgml.in
+++ b/doc/lxc.container.conf.sgml.in
@@ -1024,6 +1024,20 @@
             </para>
           </listitem>
         </varlistentry>
+        <varlistentry>
+          <term>
+            <option>lxc.tty.min</option>
+          </term>
+          <listitem>
+            <para>
+              Number of leading ttys to leave alone. With
+              <option>lxc.tty.min = 3</option> and
+              <option>lxc.tty.max = 6</option>, only
+              <filename>/dev/tty4</filename> to <filename>/dev/tty6</filename>
+              are made available. Defaults to 0.
+            </para>
+          </listitem>
+        </varlistentry>
       </variablelist>
     </refsect2>
 
diff --git a/src/lxc/conf.c b/src/lxc/conf.c
index 98232c38a..76ae09de7 100644
--- a/src/lxc/conf.c
+++ b/src/lxc/conf.c
@@ -777,7 +777,7 @@ static int lxc_setup_ttys(struct lxc_conf *conf)
 	if (!conf->rootfs.path)
 		return 0;
 
-	for (size_t i = 0; i < ttys->max; i++) {
+	for (size_t i = ttys->min; i < ttys->max; i++) {
 		__do_close int fd_to = -EBADF;
 		struct lxc_terminal_info *tty = &ttys->tty[i];
 
@@ -866,7 +866,8 @@ static int lxc_setup_ttys(struct lxc_conf *conf)
 			return log_error(-1, "Error setting up container_ttys string");
 	}
 
-	INFO("Finished setting up %zu /dev/tty<N> device(s)", ttys->max);
+	INFO("Finished setting up %zu /dev/tty<N> device(s)",
+	     ttys->max > ttys->min ? ttys->max - ttys->min : (size_t)0);
 	return 0;
 }
 
@@ -878,14 +879,14 @@ static int lxc_allocate_ttys(struct lxc_conf *conf)
 	int ret;
 
 	/* no tty in the configuration */
-	if (ttys->max == 0)
+	if (ttys->max == 0 || ttys->min >= ttys->max)
 		return 0;
 
 	ttys->tty = zalloc(sizeof(struct lxc_terminal_info) * ttys->max);
 	if (!ttys->tty)
 		return -ENOMEM;
 
-	for (size_t i = 0; i < conf->ttys.max; i++) {
+	for (size_t i = ttys->min; i < conf->ttys.max; i++) {
 		struct lxc_terminal_info *tty = &ttys->tty[i];
 
 		ret = lxc_devpts_terminal(conf->devpts_fd, &tty->ptx,
@@ -903,7 +904,7 @@ static int lxc_allocate_ttys(struct lxc_conf *conf)
 		tty->busy = -1;
 	}
 
-	INFO("Finished creating %zu tty devices", ttys->max);
+	INFO("Finished creating %zu tty devices", ttys->max - ttys->min);
 	move_ptr(ttys);
 	return 0;
 }
@@ -913,7 +914,7 @@ void lxc_delete_tty(struct lxc_tty_info *ttys)
 	if (!ttys || !ttys->tty)
 		return;
 
-	for (size_t i = 0; i < ttys->max; i++) {
+	for (size_t i = ttys->min; i < ttys->max; i++) {
 		struct lxc_terminal_info *tty = &ttys->tty[i];
 		close_prot_errno_disarm(tty->ptx);
 		close_prot_errno_disarm(tty->pty);
@@ -929,10 +930,10 @@ static int __lxc_send_ttys_to_parent(struct lxc_handler *handler)
 	struct lxc_tty_info *ttys = &conf->ttys;
 	int sock = handler->data_sock[0];
 
-	if (ttys->max == 0)
+	if (ttys->max == 0 || ttys->min >= ttys->max)
 		return 0;
 
-	for (size_t i = 0; i < ttys->max; i++) {
+	for (size_t i = ttys->min; i < ttys->max; i++) {
 		int ttyfds[2];
 		struct lxc_terminal_info *tty = &ttys->tty[i];
 
@@ -948,9 +949,9 @@ static int __lxc_send_ttys_to_parent(struct lxc_handler *handler)
 	}
 
 	if (ret < 0)
-		SYSERROR("Failed to send %zu ttys to parent", ttys->max);
+		SYSERROR("Failed to send %zu ttys to parent", ttys->max - ttys->min);
 	else
-		TRACE("Sent %zu ttys to parent", ttys->max);
+		TRACE("Sent %zu ttys to parent", ttys->max - ttys->min);
 
 	return ret;
 }
@@ -1499,7 +1500,8 @@ static int lxc_setup_devpts_child(struct lxc_handler *handler)
 	size_t pty_max = conf->pty_max;
 	int ret;
 
-	pty_max += conf->ttys.max;
+	if (conf->ttys.max > conf->ttys.min)
+		pty_max += conf->ttys.max - conf->ttys.min;
 	if (pty_max <= 0)
 		return log_debug(0, "No new devpts instance will be mounted since no pts devices are required");
 
@@ -3754,10 +3756,11 @@ static int lxc_recv_ttys_from_child(struct lxc_handler *handler)
 	struct lxc_conf *conf = handler->conf;
 	struct lxc_tty_info *tty_info = &conf->ttys;
 	size_t ttys_max = tty_info->max;
+	size_t ttys_min = tty_info->min;
 	struct lxc_terminal_info *terminal_info;
 	int ret;
 
-	if (!ttys_max)
+	if (!ttys_max || ttys_min >= ttys_max)
 		return 0;
 
 	info_new->tty = malloc(sizeof(*(info_new->tty)) * ttys_max);
@@ -3772,12 +3775,12 @@ static int lxc_recv_ttys_from_child(struct lxc_handler *handler)
 		terminal_info->pty = -EBADF;
 	}
 
-	for (size_t i = 0; i < ttys_max; i++) {
+	for (size_t i = ttys_min; i < ttys_max; i++) {
 		int ptx = -EBADF, pty = -EBADF;
 
 		ret = lxc_abstract_unix_recv_two_fds(sock, &ptx, &pty);
 		if (ret < 0)
-			return syserror("Failed to receive %zu ttys from child", ttys_max);
+			return syserror("Failed to receive %zu ttys from child", ttys_max - ttys_min);
 
 		terminal_info = &info_new->tty[i];
 		terminal_info->ptx = ptx;
@@ -3787,7 +3790,7 @@ static int lxc_recv_ttys_from_child(struct lxc_handler *handler)
 	}
 
 	tty_info->tty = move_ptr(info_new->tty);
-	TRACE("Received %zu ttys from child", ttys_max);
+	TRACE("Received %zu ttys from child", ttys_max - ttys_min);
 	return 0;
 }
 
diff --git a/src/lxc/conf.h b/src/lxc/conf.h
index fe1bd85a8..8159b01a4 100644
--- a/src/lxc/conf.h
+++ b/src/lxc/conf.h
@@ -193,10 +193,12 @@ struct id_map {
 
 /* Defines the number of tty configured and contains the
  * instantiated ptys
- * @max = number of configured ttys
+ * @max = highest configured tty index (1-based)
+ * @min = number of leading ttys to skip; tty(min+1)..tty(max) are set up
  */
 struct lxc_tty_info {
 	size_t max;
+	size_t min;
 	char *dir;
 	char *tty_names;
 	struct lxc_terminal_info *tty;
diff --git a/src/lxc/confile.c b/src/lxc/confile.c
index 08f5293e9..0add7b4a1 100644
--- a/src/lxc/confile.c
+++ b/src/lxc/confile.c
@@ -153,6 +153,7 @@ lxc_config_define(signal_reboot);
 lxc_config_define(signal_stop);
 lxc_config_define(start);
 lxc_config_define(tty_max);
+lxc_config_define(tty_min);
 lxc_config_define(tty_dir);
 lxc_config_define(uts_name);
 lxc_config_define(sysctl);
@@ -273,6 +274,7 @@ static struct lxc_config_t config_jump_table[] = {
 	{ "lxc.start.order",                true,  set_config_start,                      get_config_start,                      clr_config_start,                      },
 	{ "lxc.tty.dir",                    true,  set_config_tty_dir,                    get_config_tty_dir,                    clr_config_tty_dir,                    },
 	{ "lxc.tty.max",                    true,  set_config_tty_max,                    get_config_tty_max,                    clr_config_tty_max,                    },
+	{ "lxc.tty.min",                    true,  set_config_tty_min,                    get_config_tty_min,                    clr_config_tty_min,                    },
 	{ "lxc.uts.name",                   true,  set_config_uts_name,                   get_config_uts_name,                   clr_config_uts_name,                   },
 	{ "lxc.sysctl",                     false, set_config_sysctl,                     get_config_sysctl,                     clr_config_sysctl,                     },
 	{ "lxc.proc",                       false, set_config_proc,                       get_config_proc,                       clr_config_proc,                       },
@@ -1637,6 +1639,30 @@ static int set_config_tty_max(const char *key, const char *value,
 	return 0;
 }
 
+static int set_config_tty_min(const char *key, const char *value,
+			      struct lxc_conf *lxc_conf, void *data)
+{
+	int ret;
+	unsigned int nbtty = 0;
+
+	if (lxc_config_value_empty(value)) {
+		lxc_conf->ttys.min = 0;
+		return 0;
+	}
+
+	ret = lxc_safe_uint(value, &nbtty);
+	if (ret < 0)
+		return ret;
+
+	/* min is compared as int and as size_t + 1 elsewhere */
+	if (nbtty > INT_MAX)
+		return -ERANGE;
+
+	lxc_conf->ttys.min = nbtty;
+
+	return 0;
+}
+
 static int set_config_tty_dir(const char *key, const char *value,
 			     struct lxc_conf *lxc_conf, void *data)
 {
@@ -3770,6 +3796,12 @@ static int get_config_tty_max(const char *key, char *retv, int inlen,
 	return lxc_get_conf_size_t(c, retv, inlen, c->ttys.max);
 }
 
+static int get_config_tty_min(const char *key, char *retv, int inlen,
+			      struct lxc_conf *c, void *data)
+{
+	return lxc_get_conf_size_t(c, retv, inlen, c->ttys.min);
+}
+
 static int get_config_tty_dir(const char *key, char *retv, int inlen,
 			     struct lxc_conf *c, void *data)
 {
@@ -4822,6 +4854,13 @@ static inline int clr_config_tty_max(const char *key, struct lxc_conf *c,
 	return 0;
 }
 
+static inline int clr_config_tty_min(const char *key, struct lxc_conf *c,
+				     void *data)
+{
+	c->ttys.min = 0;
+	return 0;
+}
+
 static inline int clr_config_tty_dir(const char *key, struct lxc_conf *c,
 				    void *data)
 {
diff --git a/src/lxc/terminal.c b/src/lxc/terminal.c
index d066c2b9e..84a47d99f 100644
--- a/src/lxc/terminal.c
+++ b/src/lxc/terminal.c
@@ -640,7 +640,7 @@ int lxc_terminal_allocate(struct lxc_conf *conf, int sockfd, int *ttyreq)
 	}
 
 	if (*ttyreq > 0) {
-		if ((size_t)*ttyreq > ttys->max)
+		if ((size_t)*ttyreq <= ttys->min || (size_t)*ttyreq > ttys->max)
 			goto out;
 
 		if (ttys->tty[*ttyreq - 1].busy >= 0)
@@ -652,7 +652,7 @@ int lxc_terminal_allocate(struct lxc_conf *conf, int sockfd, int *ttyreq)
 	}
 
 	/* Search for next available tty, fixup index tty1 => [0]. */
-	for (ttynum = 1; ttynum <= ttys->max && ttys->tty[ttynum - 1].busy >= 0; ttynum++) {
+	for (ttynum = ttys->min + 1; ttynum <= ttys->max && ttys->tty[ttynum - 1].busy >= 0; ttynum++) {
 		;
 	}
 
@@ -675,7 +675,7 @@ void lxc_terminal_free(struct lxc_conf *conf, int fd)
 	struct lxc_tty_info *ttys = &conf->ttys;
 	struct lxc_terminal *terminal = &conf->console;
 
-	for (size_t i = 0; i < ttys->max; i++)
+	for (size_t i = ttys->min; i < ttys->max; i++)
 		if (ttys->tty[i].busy == fd)
 			ttys->tty[i].busy = -1;
 
