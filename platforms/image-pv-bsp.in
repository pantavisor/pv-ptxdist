## SECTION=image

config IMAGE_PV_BSP
	tristate
	select IMAGE_PV_BOOT
	help
	  The platform's generic BSP, images/pantavisor-bsp.pvrexport.tgz,
	  which QEMU's pv-hd.img is made from. The boards build their own.

if IMAGE_PV_BSP

comment "generic BSP (QEMU)"

config IMAGE_PV_BSP_DTBS
	string
	prompt "device trees for U-Boot to pick by fdtfile"
	help
	  Space separated kernel device trees, with their vendor
	  directory (e.g. "rockchip/rk3588s-orangepi-5b.dtb"), copied to
	  bsp/<path>. boot.scr loads bsp/${fdtfile} when the BSP has no
	  initial fdt. Each one must be in the kernel's DTS list.

config IMAGE_PV_BSP_FIRMWARE_PKGS
	string
	prompt "packages providing /lib/firmware"
	help
	  Space separated PTXdist package names. Their firmware goes
	  into bsp/firmware.squashfs instead of the initramfs.

endif
