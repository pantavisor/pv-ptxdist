## SECTION=pv_boards

config IMAGE_PV_HD
	tristate
	select IMAGE_PV_BOOT
	prompt "QEMU (images/pv-hd.img)      "
	help
	  Bootable Pantavisor disk for QEMU: the boot partition followed
	  by pv-storage.ext4, built from the platform's generic BSP.
	  QEMU loads U-Boot itself through -bios (scripts/run-qemu-pv.sh).
