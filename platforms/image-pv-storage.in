## SECTION=image

config IMAGE_PV_STORAGE
	tristate
	# PTXdist orders the image after what this entry itself selects
	select HOST_GENIMAGE
	select HOST_E2FSPROGS
	select IMAGE_PV_BSP
	help
	  The platform's generic storage partition, images/pv-storage.ext4
	  (ext4, label "root"), with factory revision 0 built from the
	  generic BSP. QEMU's pv-hd.img uses it; the boards build their own.
