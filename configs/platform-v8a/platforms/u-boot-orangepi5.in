## SECTION=bootloader

config U_BOOT_ORANGEPI5
	tristate
	select U_BOOT			if BUILDTIME
	select TF_A
	select RKBIN_RK3588
	select HOST_SYSTEM_PYTHON3
	select HOST_SYSTEM_PYTHON3_PYELFTOOLS
	select HOST_SYSTEM_PYTHON3_DEV
	# mkimage includes <openssl/evp.h> (CONFIG_TOOLS_LIBCRYPTO)
	select HOST_OPENSSL
	help
	  Selected by its board in Pantavisor boards.

	  Mainline U-Boot for the Orange Pi 5 (RK3588S), built from the
	  U-Boot version selected for the platform with TF-A BL31 and the
	  rkbin DDR blob. Produces images/u-boot-rockchip-orangepi5.bin,
	  to be written at 32 KiB.

	  Binman builds U-Boot's pylibfdt, which needs swig on the build
	  host (PTXdist has no host-swig).
