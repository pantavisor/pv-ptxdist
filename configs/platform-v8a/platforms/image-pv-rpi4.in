## SECTION=pv_boards

config IMAGE_PV_RPI4
	tristate
	select HOST_GENIMAGE
	select HOST_DOSFSTOOLS
	select HOST_MTOOLS
	select IMAGE_PV_BOOT
	select U_BOOT_RPI4
	prompt "Raspberry Pi 4 (images/pv-rpi4.img)"
	help
	  Pantavisor SD card image for the Raspberry Pi 4: a vfat boot
	  partition with the GPU firmware, config.txt, the devicetree,
	  U-Boot and boot.scr, then the storage partition. Its BSP
	  (images/pantavisor-bsp-rpi4.pvrexport.tgz) carries only
	  broadcom/bcm2711-rpi-4-b.dtb, which must be in the kernel's
	  devicetree list.
