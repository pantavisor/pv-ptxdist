## SECTION=image

config IMAGE_PV_ORANGEPI5B
	tristate
	select HOST_GENIMAGE
	select IMAGE_PV_HD
	select U_BOOT_ORANGEPI5B
	prompt "Generate images/pv-orangepi5b.img"
	help
	  Pantavisor SD card / eMMC image for the Orange Pi 5B: U-Boot
	  at 32 KiB, then the boot and storage partitions of pv-hd.img.
	  Needs rockchip/rk3588s-orangepi-5b.dtb in the BSP's device
	  tree list.
