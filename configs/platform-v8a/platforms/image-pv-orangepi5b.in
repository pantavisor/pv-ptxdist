## SECTION=pv_boards

config IMAGE_PV_ORANGEPI5B
	tristate
	select HOST_GENIMAGE
	select IMAGE_PV_BOOT
	select U_BOOT_ORANGEPI5B
	prompt "Orange Pi 5B (images/pv-orangepi5b.img)"
	help
	  Pantavisor SD card / eMMC image for the Orange Pi 5B: U-Boot
	  at 32 KiB, a boot partition with boot.scr and a storage
	  partition. Its BSP (images/pantavisor-bsp-orangepi5b.pvrexport.tgz)
	  carries only rockchip/rk3588s-orangepi-5b.dtb, which must be in
	  the kernel's devicetree list.
