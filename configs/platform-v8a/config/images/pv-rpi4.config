image pv-rpi4-boot.vfat {
	vfat {
		label = "PVBOOT"
	}
	size = @BOOT_SIZE@
	mountpoint = "/boot"
}

image @IMAGE@ {
	hdimage {
		align = 1M
		partition-table-type = "mbr"
	}
	# The firmware boots from the first FAT partition; boot.scr finds
	# the storage at boot partition + 1.
	partition boot {
		image = "pv-rpi4-boot.vfat"
		partition-type = 0x0c
		bootable = true
	}
	partition root {
		image = "pv-storage.ext4"
		partition-type = 0x83
	}
}
