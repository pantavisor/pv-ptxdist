image pv-orangepi5-boot.vfat {
	vfat {
		label = "PVBOOT"
	}
	size = @BOOT_SIZE@
	mountpoint = "/boot"
}

image pv-orangepi5-storage.ext4 {
	ext4 {
		use-mke2fs = true
		# Pantavisor finds its storage by label (PV_STORAGE_DEVICE=LABEL=root).
		label = "root"
	}
	size = @STORAGE_SIZE@
	mountpoint = "/storage"
}

image @IMAGE@ {
	hdimage {
		align = 1M
		partition-table-type = "gpt"
	}
	# The boot ROM loads idbloader from sector 64; the GPT ends at
	# sector 34.
	partition u-boot {
		offset = 32k
		size = 16352k
		in-partition-table = false
		image = "u-boot-rockchip-orangepi5.bin"
	}
	# Bootstd only scans partitions flagged bootable when there are
	# any; boot.scr finds the storage at boot partition + 1.
	partition boot {
		image = "pv-orangepi5-boot.vfat"
		partition-type-uuid = "F"
		bootable = true
	}
	partition root {
		image = "pv-orangepi5-storage.ext4"
		partition-type-uuid = "L"
	}
}
