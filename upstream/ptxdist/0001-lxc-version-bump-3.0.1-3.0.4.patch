From 1ca3b9aecee035d702ec3f86b1c3d8561066c130 Mon Sep 17 00:00:00 2001
From: Fernando Luiz Cola <fernando.luiz@pantacor.com>
Date: Thu, 29 Oct 2026 19:02:22 -0300
Subject: [PATCH] lxc: version bump 3.0.1 -> 3.0.4

3.0.4 is the last release of the 3.0 LTS branch. It includes the fix
for CVE-2019-5736 (runc/liblxc binary overwrite), which is on by default
through --enable-memfd-rexec.

--disable-gnutls is gone in 3.0.x; use --disable-openssl instead, which
also pins the auto-detected OpenSSL support. Set the other new options
explicitly.

Set the license: COPYING is LGPL-2.1-or-later, but liblxc also builds
GPL-2.0-only sources such as src/lxc/confile_utils.c, so add its header
as a second license file.

Signed-off-by: Fernando Luiz Cola <fernando.luiz@pantacor.com>
---
 rules/lxc.make | 14 ++++++++++----
 1 file changed, 10 insertions(+), 4 deletions(-)

diff --git a/rules/lxc.make b/rules/lxc.make
index 762a68ed4..424a267f5 100644
--- a/rules/lxc.make
+++ b/rules/lxc.make
@@ -14,14 +14,17 @@ PACKAGES-$(PTXCONF_LXC) += lxc
 #
 # Paths and names
 #
-LXC_VERSION	:= 3.0.1
-LXC_SHA256	:= 45986c49be1c048fa127bd3e7ea1bd3347e25765c008a09a2e4c233151a2d5db
+LXC_VERSION	:= 3.0.4
+LXC_SHA256	:= 0e2729610e4b13c89e25cfbe2664f676f1861c3abfa97c791f4b9efc0ea7b56b
 LXC		:= lxc-$(LXC_VERSION)
 LXC_SUFFIX	:= tar.gz
 LXC_URL		:= https://linuxcontainers.org/downloads/lxc/$(LXC).$(LXC_SUFFIX)
 LXC_SOURCE	:= $(SRCDIR)/$(LXC).$(LXC_SUFFIX)
 LXC_DIR		:= $(BUILDDIR)/$(LXC)
-LXC_LICENSE	:= unknown
+LXC_LICENSE	:= LGPL-2.1-or-later AND GPL-2.0-only
+LXC_LICENSE_FILES	:= \
+	file://COPYING;md5=4fbd65380cdd255951079008b364516c \
+	file://src/lxc/confile_utils.c;startline=1;endline=18;md5=bc4695fbc613efaf207d0ed6ac13de41
 
 # ----------------------------------------------------------------------------
 # Prepare
@@ -46,17 +49,20 @@ LXC_CONF_OPT	:= \
 	--disable-doc \
 	--disable-api-docs \
 	--disable-apparmor \
-	--disable-gnutls \
+	--disable-openssl \
 	--$(call ptx/endis, PTXCONF_GLOBAL_SELINUX)-selinux \
 	--enable-seccomp \
 	--enable-capabilities \
 	--disable-examples \
 	--disable-mutex-debugging \
+	--disable-asan \
 	--disable-bash \
 	--enable-tools \
 	--enable-commands \
 	--$(call ptx/endis, PTXCONF_LXC_TEST_TOOLS)-tests \
 	--enable-configpath-log \
+	--enable-thread-safety \
+	--enable-memfd-rexec \
 	--disable-pam \
 	--with-init-script=systemd \
 	--with-systemdsystemunitdir=/usr/lib/systemd/system/ \
