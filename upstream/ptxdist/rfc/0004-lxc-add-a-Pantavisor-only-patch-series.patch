+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/src/lxc/cgroups/cgroup.h b/src/lxc/cgroups/cgroup.h
+index 108e5d84e..a69239265 100644
+--- a/src/lxc/cgroups/cgroup.h
++++ b/src/lxc/cgroups/cgroup.h
+@@ -18,7 +18,7 @@
+ 
+ #define DEFAULT_CGROUP_MOUNTPOINT_RELATIVE "sys/fs/cgroup"
+ #define DEFAULT_CGROUP_MOUNTPOINT "/sys/fs/cgroup"
+-#define DEFAULT_PAYLOAD_CGROUP_PREFIX "lxc.payload."
++#define DEFAULT_PAYLOAD_CGROUP_PREFIX "lxc/"
+ #define DEFAULT_MONITOR_CGROUP_PREFIX "lxc.monitor."
+ #define DEFAULT_PAYLOAD_CGROUP "payload"
+ #define DEFAULT_MONITOR_CGROUP "monitor"
diff --git a/patches/lxc-6.0.6/0007-support-hook-commands-with-parameters.patch b/patches/lxc-6.0.6/0007-support-hook-commands-with-parameters.patch
new file mode 100644
index 000000000..60da680e2
--- /dev/null
+++ b/patches/lxc-6.0.6/0007-support-hook-commands-with-parameters.patch
@@ -0,0 +1,42 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Alexander Sack <asac@pantacor.com>
+Date: Sat, 17 Jan 2026 13:30:08 +0000
+Subject: [PATCH] support hook commands with parameters
+
+Allow start hooks to include command-line parameters, e.g.:
+  lxc.hook.start = /usr/bin/script.sh arg1 arg2
+
+The verification now extracts just the command name (before any space)
+to check for file existence, while preserving the full command line
+for execution.
+---
+ src/lxc/conf.c | 12 ++++++++++++
+ 1 file changed, 12 insertions(+)
+
+diff --git a/src/lxc/conf.c b/src/lxc/conf.c
+index bf2695158..99360dbe9 100644
+--- a/src/lxc/conf.c
++++ b/src/lxc/conf.c
+@@ -3541,10 +3541,22 @@ static bool verify_start_hooks(struct lxc_conf *conf)
+ 	list_for_each_entry(hook, &conf->hooks[LXCHOOK_START], head) {
+ 		int ret;
+ 		char *hookname = hook->val;
++		char *cmdend, sav = '\0';
++
++		/* Extract command name without parameters for access check */
++		cmdend = strchr(hookname, ' ');
++		if (cmdend) {
++			sav = *cmdend;
++			*cmdend = '\0';
++		}
+ 
+ 		ret = strnprintf(path, sizeof(path), "%s%s",
+ 			       conf->rootfs.path ? conf->rootfs.mount : "",
+ 			       hookname);
++
++		if (cmdend)
++			*cmdend = sav;
++
+ 		if (ret < 0)
+ 			return false;
+ 
diff --git a/patches/lxc-6.0.6/0008-allow-overlay-mount-entries-with-upper-workdir-outsi.patch b/patches/lxc-6.0.6/0008-allow-overlay-mount-entries-with-upper-workdir-outsi.patch
new file mode 100644
index 000000000..8c7355714
--- /dev/null
+++ b/patches/lxc-6.0.6/0008-allow-overlay-mount-entries-with-upper-workdir-outsi.patch
@@ -0,0 +1,66 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Alexander Sack <asac@pantacor.com>
+Date: Sat, 17 Jan 2026 13:30:44 +0000
+Subject: [PATCH] allow overlay mount entries with upper/workdir outside
+ container dir
+
+Remove the restriction that overlay upperdir and workdir must be inside
+the container directory. They can now be anywhere as long as they are
+not inside the rootfs.
+
+This is useful for Pantavisor where overlay directories may be located
+outside the standard LXC container path.
+---
+ src/lxc/storage/overlay.c | 22 +++++++++++++---------
+ 1 file changed, 13 insertions(+), 9 deletions(-)
+
+diff --git a/src/lxc/storage/overlay.c b/src/lxc/storage/overlay.c
+index 443c8dc3c..05d2a083a 100644
+--- a/src/lxc/storage/overlay.c
++++ b/src/lxc/storage/overlay.c
+@@ -611,22 +611,25 @@ int ovl_mkdir(const struct mntent *mntent, const struct lxc_rootfs *rootfs,
+ 		rootfs_dir = ovl_get_rootfs(rootfs_path, &rootfslen);
+ 		if (!rootfs_dir)
+ 			goto err;
+-
+-		dirlen = strlen(lxcpath);
+ 	}
+ 
++	TRACE("ovl_mkdir: rootfs_dir=%s lxcdir=%s done parsing opts: upper=%s,work=%s",
++	      rootfs_dir ? rootfs_dir : "<NA>",
++	      lxcpath[0] ? lxcpath : "<NA>",
++	      upperdir ? upperdir : "<NA>", workdir ? workdir : "<NA>");
++
+ 	/*
+-	 * We neither allow users to create upperdirs and workdirs outside the
+-	 * containerdir nor inside the rootfs. The latter might be debatable.
+-	 * When we have a container without a rootfs we skip the checks.
++	 * Allow upperdirs and workdirs outside the containerdir, but not inside
++	 * the rootfs. When we have a container without a rootfs we skip the checks.
+ 	 */
+ 	ret = 0;
+ 	if (upperdir) {
+ 		if (!rootfs_path)
+ 			ret = lxc_mkdir_p(upperdir, 0755);
+-		else if (!strncmp(upperdir, lxcpath, dirlen) &&
+-			 strncmp(upperdir, rootfs_dir, rootfslen))
++		else if (strncmp(upperdir, rootfs_dir, rootfslen))
+ 			ret = lxc_mkdir_p(upperdir, 0755);
++		else
++			INFO("Invalid upperdir (%s): must not be inside rootfs (%s)", upperdir, rootfs_dir);
+ 
+ 		if (ret < 0)
+ 			SYSWARN("Failed to create directory \"%s\"", upperdir);
+@@ -636,9 +639,10 @@ int ovl_mkdir(const struct mntent *mntent, const struct lxc_rootfs *rootfs,
+ 	if (workdir) {
+ 		if (!rootfs_path)
+ 			ret = lxc_mkdir_p(workdir, 0755);
+-		else if (!strncmp(workdir, lxcpath, dirlen) &&
+-			 strncmp(workdir, rootfs_dir, rootfslen))
++		else if (strncmp(workdir, rootfs_dir, rootfslen))
+ 			ret = lxc_mkdir_p(workdir, 0755);
++		else
++			INFO("Invalid workdir (%s): must not be inside rootfs (%s)", workdir, rootfs_dir);
+ 
+ 		if (ret < 0)
+ 			SYSWARN("Failed to create directory \"%s\"", workdir);
diff --git a/patches/lxc-6.0.6/0009-support-exports-mounts-for-Pantavisor.patch b/patches/lxc-6.0.6/0009-support-exports-mounts-for-Pantavisor.patch
new file mode 100644
index 000000000..4453c3a33
--- /dev/null
+++ b/patches/lxc-6.0.6/0009-support-exports-mounts-for-Pantavisor.patch
@@ -0,0 +1,36 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Alexander Sack <asac@pantacor.com>
+Date: Sat, 17 Jan 2026 13:36:25 +0000
+Subject: [PATCH] support /exports mounts for Pantavisor
+
+Skip unmounting /exports during chroot and preserve shared mount
+propagation for exports mounts. This is needed for Pantavisor's
+exports mechanism where containers can expose directories to
+other containers.
+---
+ src/lxc/conf.c | 5 ++++-
+ 1 file changed, 4 insertions(+), 1 deletion(-)
+
+diff --git a/src/lxc/conf.c b/src/lxc/conf.c
+index 99360dbe9..c0bd87699 100644
+--- a/src/lxc/conf.c
++++ b/src/lxc/conf.c
+@@ -1315,6 +1315,9 @@ static int lxc_chroot(const struct lxc_rootfs *rootfs)
+ 			if (strequal(slider1 + 1, "/proc"))
+ 				continue;
+ 
++			if (strnequal(slider1 + 1, "/exports", 8))
++				continue;
++
+ 			ret = umount2(slider1, MNT_DETACH);
+ 			if (ret == 0)
+ 				progress++;
+@@ -3476,7 +3479,7 @@ static void turn_into_dependent_mounts(const struct lxc_rootfs *rootfs)
+ 			continue;
+ 
+ 		null_endofword(opts);
+-		if (!strstr(opts, "shared"))
++		if (!strstr(opts, "shared") || strstr(target, "exports"))
+ 			continue;
+ 
+ 		null_endofword(target);
diff --git a/patches/lxc-6.0.6/0010-block-SIGCHLD-in-run_buffer-to-prevent-child-reaping.patch b/patches/lxc-6.0.6/0010-block-SIGCHLD-in-run_buffer-to-prevent-child-reaping.patch
new file mode 100644
index 000000000..fcb3f9f53
--- /dev/null
+++ b/patches/lxc-6.0.6/0010-block-SIGCHLD-in-run_buffer-to-prevent-child-reaping.patch
@@ -0,0 +1,63 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Alexander Sack <asac@pantacor.com>
+Date: Sat, 17 Jan 2026 13:36:54 +0000
+Subject: [PATCH] block SIGCHLD in run_buffer to prevent child reaping issues
+
+Block SIGCHLD during the lxc_popen/lxc_pclose critical section to
+prevent the parent process (e.g., Pantavisor) from reaping the child
+before lxc_pclose() can retrieve its exit status.
+
+This replaces the earlier setpgrp() approach which was insufficient.
+---
+ src/lxc/start.c |  3 ++-
+ src/lxc/utils.c | 16 ++++++++++++++++
+ 2 files changed, 18 insertions(+), 1 deletion(-)
+
+diff --git a/src/lxc/start.c b/src/lxc/start.c
+index b7ce830ca..3d7a61a28 100644
+--- a/src/lxc/start.c
++++ b/src/lxc/start.c
+@@ -1362,7 +1362,8 @@ static int do_start(void *data)
+ 	if (ret < 0)
+ 		goto out_warn_father;
+ 
+-	{
++	/* Set container= env var unless type is "pv-root" (Pantavisor root platform) */
++	if (!handler->conf->type || !strequal(handler->conf->type, "pv-root")) {
+ 		const char *container_type = handler->conf->type ? handler->conf->type : "lxc";
+ 		char *container_env = must_make_path("container=", container_type, NULL);
+ 		ret = putenv(container_env);
+diff --git a/src/lxc/utils.c b/src/lxc/utils.c
+index 1e41d642a..c4712f046 100644
+--- a/src/lxc/utils.c
++++ b/src/lxc/utils.c
+@@ -536,6 +536,18 @@ static int run_buffer(char *buffer)
+ 	__do_free char *output = NULL;
+ 	__do_lxc_pclose struct lxc_popen_FILE *f = NULL;
+ 	int fd, ret;
++	sigset_t set, oldset;
++
++	/*
++	 * Block SIGCHLD to prevent the parent process from reaping
++	 * the child before lxc_pclose() can do so. This is needed when
++	 * LXC is used as a library (e.g., by Pantavisor).
++	 */
++	sigemptyset(&set);
++	sigaddset(&set, SIGCHLD);
++	ret = pthread_sigmask(SIG_BLOCK, &set, &oldset);
++	if (ret != 0)
++		SYSWARN("Failed to block SIGCHLD");
+ 
+ 	f = lxc_popen(buffer);
+ 	if (!f)
+@@ -563,6 +575,10 @@ static int run_buffer(char *buffer)
+ 	}
+ 
+ 	ret = lxc_pclose(move_ptr(f));
++
++	/* Restore the original signal mask */
++	pthread_sigmask(SIG_SETMASK, &oldset, NULL);
++
+ 	if (ret == -1)
+ 		return log_error_errno(-1, errno, "Script exited with error");
+ 	else if (WIFEXITED(ret) && WEXITSTATUS(ret) != 0)
diff --git a/patches/lxc-6.0.6/0011-conf-match-pivot_root-mount-propagation-in-lxc_chroo.patch b/patches/lxc-6.0.6/0011-conf-match-pivot_root-mount-propagation-in-lxc_chroo.patch
new file mode 100644
index 000000000..325630f31
--- /dev/null
+++ b/patches/lxc-6.0.6/0011-conf-match-pivot_root-mount-propagation-in-lxc_chroo.patch
@@ -0,0 +1,70 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Alexander Sack <alexander.sack@pantacor.com>
+Date: Fri, 16 Oct 2026 12:29:29 +0000
+Subject: [PATCH] conf: match pivot_root mount propagation in lxc_chroot
+
+lxc_chroot() made the whole tree private, dropping the propagation the
+rootfs and lxc.mount.entry lines asked for. Keep it, as lxc_pivot_root()
+does, and only make the old tree slave before it is unmounted.
+
+Signed-off-by: Alexander Sack <alexander.sack@pantacor.com>
+---
+ src/lxc/conf.c | 23 +++++++++++++++++++++--
+ 1 file changed, 21 insertions(+), 2 deletions(-)
+
+diff --git a/src/lxc/conf.c b/src/lxc/conf.c
+index c0bd87699..98232c38a 100644
+--- a/src/lxc/conf.c
++++ b/src/lxc/conf.c
+@@ -1270,9 +1270,21 @@ static int lxc_chroot(const struct lxc_rootfs *rootfs)
+ 	if (ret < 0)
+ 		return log_error_errno(-1, errno, "Failed to mount \"%s\" onto \"/\" as MS_REC | MS_BIND", nroot);
+ 
+-	ret = mount(NULL, "/", NULL, MS_REC | MS_PRIVATE, NULL);
++	/*
++	 * The copy on "/" keeps the propagation the rootfs and the mount
++	 * entries were set up with, as with pivot_root(). Turn the old root
++	 * and the old rootfs into dependent mounts instead, so cleaning them
++	 * up below propagates neither to the host nor into the copy. "/"
++	 * still resolves to the old root here and MS_REC on it would also
++	 * reach the copy.
++	 */
++	ret = mount(NULL, "/", NULL, MS_SLAVE, NULL);
++	if (ret < 0)
++		return log_error_errno(-1, errno, "Failed to turn old root into dependent mount");
++
++	ret = mount(NULL, nroot, NULL, MS_SLAVE | MS_REC, NULL);
+ 	if (ret < 0)
+-		return log_error_errno(-1, errno, "Failed to remount \"/\"");
++		return log_error_errno(-1, errno, "Failed to recursively turn \"%s\" into dependent mount", nroot);
+ 
+ 	/* The following code cleans up inherited mounts which are not required
+ 	 * for CT.
+@@ -1318,6 +1330,7 @@ static int lxc_chroot(const struct lxc_rootfs *rootfs)
+ 			if (strnequal(slider1 + 1, "/exports", 8))
+ 				continue;
+ 
++			(void)mount(NULL, slider1, NULL, MS_SLAVE | MS_REC, NULL);
+ 			ret = umount2(slider1, MNT_DETACH);
+ 			if (ret == 0)
+ 				progress++;
+@@ -1328,6 +1341,7 @@ static int lxc_chroot(const struct lxc_rootfs *rootfs)
+ 	}
+ 
+ 	/* This also can be skipped if a container uses userns. */
++	(void)mount(NULL, "./proc", NULL, MS_SLAVE | MS_REC, NULL);
+ 	(void)umount2("./proc", MNT_DETACH);
+ 
+ 	/* It is weird, but chdir("..") moves us in a new root */
+@@ -1339,6 +1353,11 @@ static int lxc_chroot(const struct lxc_rootfs *rootfs)
+ 	if (ret < 0)
+ 		return log_error_errno(-1, errno, "Failed to chroot(\".\")");
+ 
++	/* Same as lxc_pivot_root(): the rootfs becomes its own peer group. */
++	ret = mount("", "/", "", MS_SHARED | MS_REC, NULL);
++	if (ret < 0)
++		return log_error_errno(-1, errno, "Failed to turn new root mount tree into shared mount tree");
++
+ 	return 0;
+ }
+ 
diff --git a/patches/lxc-6.0.6/0012-confile-add-lxc.tty.min-as-lower-bound-of-tty-alloca.patch b/patches/lxc-6.0.6/0012-confile-add-lxc.tty.min-as-lower-bound-of-tty-alloca.patch
new file mode 100644
index 000000000..2984b3ae7
--- /dev/null
+++ b/patches/lxc-6.0.6/0012-confile-add-lxc.tty.min-as-lower-bound-of-tty-alloca.patch
@@ -0,0 +1,304 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Alexander Sack <alexander.sack@pantacor.com>
+Date: Thu, 5 Nov 2026 09:50:25 +0000
+Subject: [PATCH] confile: add lxc.tty.min as lower bound of tty allocation
+
+The 3.0 branch had this key only as a recipe patch, so the rebase to 6.0
+dropped it and a config with lxc.tty.min failed to load.
+
+With lxc.tty.min = 3 and lxc.tty.max = 6, only /dev/tty4 to /dev/tty6
+are made container ttys and /dev/tty1 to /dev/tty3 are left alone. The
+default of 0 behaves as before. A min that is not below max sets up no
+ttys. A console request for a tty at or below min is refused.
+
+Signed-off-by: Alexander Sack <alexander.sack@pantacor.com>
+---
+ doc/lxc.container.conf.sgml.in | 14 ++++++++++++
+ src/lxc/conf.c                 | 33 +++++++++++++++-------------
+ src/lxc/conf.h                 |  4 +++-
+ src/lxc/confile.c              | 39 ++++++++++++++++++++++++++++++++++
+ src/lxc/terminal.c             |  6 +++---
+ 5 files changed, 77 insertions(+), 19 deletions(-)
+
+diff --git a/doc/lxc.container.conf.sgml.in b/doc/lxc.container.conf.sgml.in
+index 20ae63fd4..7a91cc41a 100644
+--- a/doc/lxc.container.conf.sgml.in
++++ b/doc/lxc.container.conf.sgml.in
+@@ -1024,6 +1024,20 @@
+             </para>
+           </listitem>
+         </varlistentry>
++        <varlistentry>
++          <term>
++            <option>lxc.tty.min</option>
++          </term>
++          <listitem>
++            <para>
++              Number of leading ttys to leave alone. With
++              <option>lxc.tty.min = 3</option> and
++              <option>lxc.tty.max = 6</option>, only
++              <filename>/dev/tty4</filename> to <filename>/dev/tty6</filename>
++              are made available. Defaults to 0.
++            </para>
++          </listitem>
++        </varlistentry>
+       </variablelist>
+     </refsect2>
+ 
+diff --git a/src/lxc/conf.c b/src/lxc/conf.c
+index 98232c38a..76ae09de7 100644
+--- a/src/lxc/conf.c
++++ b/src/lxc/conf.c
+@@ -777,7 +777,7 @@ static int lxc_setup_ttys(struct lxc_conf *conf)
+ 	if (!conf->rootfs.path)
+ 		return 0;
+ 
+-	for (size_t i = 0; i < ttys->max; i++) {
++	for (size_t i = ttys->min; i < ttys->max; i++) {
+ 		__do_close int fd_to = -EBADF;
+ 		struct lxc_terminal_info *tty = &ttys->tty[i];
+ 
+@@ -866,7 +866,8 @@ static int lxc_setup_ttys(struct lxc_conf *conf)
+ 			return log_error(-1, "Error setting up container_ttys string");
+ 	}
+ 
+-	INFO("Finished setting up %zu /dev/tty<N> device(s)", ttys->max);
++	INFO("Finished setting up %zu /dev/tty<N> device(s)",
++	     ttys->max > ttys->min ? ttys->max - ttys->min : (size_t)0);
+ 	return 0;
+ }
+ 
+@@ -878,14 +879,14 @@ static int lxc_allocate_ttys(struct lxc_conf *conf)
+ 	int ret;
+ 
+ 	/* no tty in the configuration */
+-	if (ttys->max == 0)
++	if (ttys->max == 0 || ttys->min >= ttys->max)
+ 		return 0;
+ 
+ 	ttys->tty = zalloc(sizeof(struct lxc_terminal_info) * ttys->max);
+ 	if (!ttys->tty)
+ 		return -ENOMEM;
+ 
+-	for (size_t i = 0; i < conf->ttys.max; i++) {
++	for (size_t i = ttys->min; i < conf->ttys.max; i++) {
+ 		struct lxc_terminal_info *tty = &ttys->tty[i];
+ 
+ 		ret = lxc_devpts_terminal(conf->devpts_fd, &tty->ptx,
+@@ -903,7 +904,7 @@ static int lxc_allocate_ttys(struct lxc_conf *conf)
+ 		tty->busy = -1;
+ 	}
+ 
+-	INFO("Finished creating %zu tty devices", ttys->max);
++	INFO("Finished creating %zu tty devices", ttys->max - ttys->min);
+ 	move_ptr(ttys);
+ 	return 0;
+ }
+@@ -913,7 +914,7 @@ void lxc_delete_tty(struct lxc_tty_info *ttys)
+ 	if (!ttys || !ttys->tty)
+ 		return;
+ 
+-	for (size_t i = 0; i < ttys->max; i++) {
++	for (size_t i = ttys->min; i < ttys->max; i++) {
+ 		struct lxc_terminal_info *tty = &ttys->tty[i];
+ 		close_prot_errno_disarm(tty->ptx);
+ 		close_prot_errno_disarm(tty->pty);
+@@ -929,10 +930,10 @@ static int __lxc_send_ttys_to_parent(struct lxc_handler *handler)
+ 	struct lxc_tty_info *ttys = &conf->ttys;
+ 	int sock = handler->data_sock[0];
+ 
+-	if (ttys->max == 0)
++	if (ttys->max == 0 || ttys->min >= ttys->max)
+ 		return 0;
+ 
+-	for (size_t i = 0; i < ttys->max; i++) {
++	for (size_t i = ttys->min; i < ttys->max; i++) {
+ 		int ttyfds[2];
+ 		struct lxc_terminal_info *tty = &ttys->tty[i];
+ 
+@@ -948,9 +949,9 @@ static int __lxc_send_ttys_to_parent(struct lxc_handler *handler)
+ 	}
+ 
+ 	if (ret < 0)
+-		SYSERROR("Failed to send %zu ttys to parent", ttys->max);
++		SYSERROR("Failed to send %zu ttys to parent", ttys->max - ttys->min);
+ 	else
+-		TRACE("Sent %zu ttys to parent", ttys->max);
++		TRACE("Sent %zu ttys to parent", ttys->max - ttys->min);
+ 
+ 	return ret;
+ }
+@@ -1499,7 +1500,8 @@ static int lxc_setup_devpts_child(struct lxc_handler *handler)
+ 	size_t pty_max = conf->pty_max;
+ 	int ret;
+ 
+-	pty_max += conf->ttys.max;
++	if (conf->ttys.max > conf->ttys.min)
++		pty_max += conf->ttys.max - conf->ttys.min;
+ 	if (pty_max <= 0)
+ 		return log_debug(0, "No new devpts instance will be mounted since no pts devices are required");
+ 
+@@ -3754,10 +3756,11 @@ static int lxc_recv_ttys_from_child(struct lxc_handler *handler)
+ 	struct lxc_conf *conf = handler->conf;
+ 	struct lxc_tty_info *tty_info = &conf->ttys;
+ 	size_t ttys_max = tty_info->max;
++	size_t ttys_min = tty_info->min;
+ 	struct lxc_terminal_info *terminal_info;
+ 	int ret;
+ 
+-	if (!ttys_max)
++	if (!ttys_max || ttys_min >= ttys_max)
+ 		return 0;
+ 
+ 	info_new->tty = malloc(sizeof(*(info_new->tty)) * ttys_max);
+@@ -3772,12 +3775,12 @@ static int lxc_recv_ttys_from_child(struct lxc_handler *handler)
+ 		terminal_info->pty = -EBADF;
+ 	}
+ 
+-	for (size_t i = 0; i < ttys_max; i++) {
++	for (size_t i = ttys_min; i < ttys_max; i++) {
+ 		int ptx = -EBADF, pty = -EBADF;
+ 
+ 		ret = lxc_abstract_unix_recv_two_fds(sock, &ptx, &pty);
+ 		if (ret < 0)
+-			return syserror("Failed to receive %zu ttys from child", ttys_max);
++			return syserror("Failed to receive %zu ttys from child", ttys_max - ttys_min);
+ 
+ 		terminal_info = &info_new->tty[i];
+ 		terminal_info->ptx = ptx;
+@@ -3787,7 +3790,7 @@ static int lxc_recv_ttys_from_child(struct lxc_handler *handler)
+ 	}
+ 
+ 	tty_info->tty = move_ptr(info_new->tty);
+-	TRACE("Received %zu ttys from child", ttys_max);
++	TRACE("Received %zu ttys from child", ttys_max - ttys_min);
+ 	return 0;
+ }
+ 
+diff --git a/src/lxc/conf.h b/src/lxc/conf.h
+index fe1bd85a8..8159b01a4 100644
+--- a/src/lxc/conf.h
++++ b/src/lxc/conf.h
+@@ -193,10 +193,12 @@ struct id_map {
+ 
+ /* Defines the number of tty configured and contains the
+  * instantiated ptys
+- * @max = number of configured ttys
++ * @max = highest configured tty index (1-based)
++ * @min = number of leading ttys to skip; tty(min+1)..tty(max) are set up
+  */
+ struct lxc_tty_info {
+ 	size_t max;
++	size_t min;
+ 	char *dir;
+ 	char *tty_names;
+ 	struct lxc_terminal_info *tty;
+diff --git a/src/lxc/confile.c b/src/lxc/confile.c
+index 08f5293e9..0add7b4a1 100644
+--- a/src/lxc/confile.c
++++ b/src/lxc/confile.c
+@@ -153,6 +153,7 @@ lxc_config_define(signal_reboot);
+ lxc_config_define(signal_stop);
+ lxc_config_define(start);
+ lxc_config_define(tty_max);
++lxc_config_define(tty_min);
+ lxc_config_define(tty_dir);
+ lxc_config_define(uts_name);
+ lxc_config_define(sysctl);
+@@ -273,6 +274,7 @@ static struct lxc_config_t config_jump_table[] = {
+ 	{ "lxc.start.order",                true,  set_config_start,                      get_config_start,                      clr_config_start,                      },
+ 	{ "lxc.tty.dir",                    true,  set_config_tty_dir,                    get_config_tty_dir,                    clr_config_tty_dir,                    },
+ 	{ "lxc.tty.max",                    true,  set_config_tty_max,                    get_config_tty_max,                    clr_config_tty_max,                    },
++	{ "lxc.tty.min",                    true,  set_config_tty_min,                    get_config_tty_min,                    clr_config_tty_min,                    },
+ 	{ "lxc.uts.name",                   true,  set_config_uts_name,                   get_config_uts_name,                   clr_config_uts_name,                   },
+ 	{ "lxc.sysctl",                     false, set_config_sysctl,                     get_config_sysctl,                     clr_config_sysctl,                     },
+ 	{ "lxc.proc",                       false, set_config_proc,                       get_config_proc,                       clr_config_proc,                       },
+@@ -1637,6 +1639,30 @@ static int set_config_tty_max(const char *key, const char *value,
+ 	return 0;
+ }
+ 
++static int set_config_tty_min(const char *key, const char *value,
++			      struct lxc_conf *lxc_conf, void *data)
++{
++	int ret;
++	unsigned int nbtty = 0;
++
++	if (lxc_config_value_empty(value)) {
++		lxc_conf->ttys.min = 0;
++		return 0;
++	}
++
++	ret = lxc_safe_uint(value, &nbtty);
++	if (ret < 0)
++		return ret;
++
++	/* min is compared as int and as size_t + 1 elsewhere */
++	if (nbtty > INT_MAX)
++		return -ERANGE;
++
++	lxc_conf->ttys.min = nbtty;
++
++	return 0;
++}
++
+ static int set_config_tty_dir(const char *key, const char *value,
+ 			     struct lxc_conf *lxc_conf, void *data)
+ {
+@@ -3770,6 +3796,12 @@ static int get_config_tty_max(const char *key, char *retv, int inlen,
+ 	return lxc_get_conf_size_t(c, retv, inlen, c->ttys.max);
+ }
+ 
++static int get_config_tty_min(const char *key, char *retv, int inlen,
++			      struct lxc_conf *c, void *data)
++{
++	return lxc_get_conf_size_t(c, retv, inlen, c->ttys.min);
++}
++
+ static int get_config_tty_dir(const char *key, char *retv, int inlen,
+ 			     struct lxc_conf *c, void *data)
+ {
+@@ -4822,6 +4854,13 @@ static inline int clr_config_tty_max(const char *key, struct lxc_conf *c,
+ 	return 0;
