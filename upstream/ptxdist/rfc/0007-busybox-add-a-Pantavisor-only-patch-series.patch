+ static char *newroot = NULL;
+@@ -584,7 +588,8 @@ static char *build_alias(char *alias, const char *device_name)
+ static void make_device(char *device_name, char *path, int operation)
+ {
+ 	int major, minor, type, len;
+-	char *path_end = path + strlen(path);
++	int path_len = strlen(path);
++	char *path_end = path + path_len;
+ #if ENABLE_FEATURE_MDEV_FOLLOW_X_ROOT
+ 	struct stat st;
+ 
+@@ -607,7 +612,8 @@ static void make_device(char *device_name, char *path, int operation)
+ 	major = -1;
