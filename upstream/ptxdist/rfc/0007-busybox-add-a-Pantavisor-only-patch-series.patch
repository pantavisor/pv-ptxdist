+ 	}
++
+ 	/* Determine device type */
+ 	/*
+ 	 * http://kernel.org/doc/pending/hotplug.txt says that only
+@@ -686,6 +712,7 @@ static void make_device(char *device_name, char *path, int operation)
+ 			memset(off, 0, sizeof(off));
+ 			goto rule_matches;
+ 		}
++
+ 		if (rule->envvar) { /* $envvar=regex rule */
+ 			str_to_match = getenv(rule->envvar);
+ 			dbg3("getenv('%s'):'%s'", rule->envvar, str_to_match);
+@@ -719,7 +746,7 @@ static void make_device(char *device_name, char *path, int operation)
+ #endif
+ 		/* Build alias name */
+ 		alias = NULL;
+-		if (ENABLE_FEATURE_MDEV_RENAME && rule->ren_mov) {
++		if (ENABLE_FEATURE_MDEV_RENAME && operation != OP_modalias && rule->ren_mov) {
+ 			aliaslink = rule->ren_mov[0];
+ 			if (aliaslink == '!') {
+ 				/* "!": suppress node creation/deletion */
+@@ -780,7 +807,7 @@ static void make_device(char *device_name, char *path, int operation)
+ 
+ 		/* "Execute" the line we found */
+ 		node_name = device_name;
+-		if (ENABLE_FEATURE_MDEV_RENAME && alias) {
++		if (ENABLE_FEATURE_MDEV_RENAME && operation != OP_modalias && alias) {
+ 			node_name = alias = build_alias(alias, device_name);
+ 			dbg3("alias2:'%s'", alias);
+ 		}
+@@ -843,7 +870,7 @@ static void make_device(char *device_name, char *path, int operation)
+ 			unlink(node_name);
+ 		}
+ 
+-		if (ENABLE_FEATURE_MDEV_RENAME)
++		if (ENABLE_FEATURE_MDEV_RENAME && operation != OP_modalias)
+ 			free(alias);
+ 
+ 		/* We found matching line.
+@@ -908,6 +935,28 @@ static int FAST_FUNC fileAction(struct recursive_state *state,
+ 	return TRUE;
+ }
+ 
++/* File callback for /sys/ traversal.
++ * We act only on "/sys/.../dev" (pseudo)file
++ */
++static int FAST_FUNC fileActionModalias(struct recursive_state *state,
++		const char *fileName,
++		struct stat *statbuf UNUSED_PARAM)
++{
++	size_t len = strlen(fileName) - 9; /* can't underflow */
++	char *path = state->userData;	/* char array[PATH_MAX + SCRATCH_SIZE] */
++
++	/* Is it a ".../dev" file? (len check is for paranoid reasons) */
++	if (strcmp(fileName + len, "/modalias") != 0 || len >= PATH_MAX - 32)
++		return FALSE; /* not .../dev */
++
++	strcpy(path, fileName);
++	path[len] = '\0';
++
++	make_device(/*DEVNAME:*/ NULL, path, OP_modalias);
++
++	return TRUE;
++}
++
+ /* Directory callback for /sys/ traversal */
+ static int FAST_FUNC dirAction(struct recursive_state *state,
+ 		const char *fileName UNUSED_PARAM,
+@@ -916,6 +965,14 @@ static int FAST_FUNC dirAction(struct recursive_state *state,
+ 	return (state->depth >= MAX_SYSFS_DEPTH ? SKIP : TRUE);
+ }
+ 
