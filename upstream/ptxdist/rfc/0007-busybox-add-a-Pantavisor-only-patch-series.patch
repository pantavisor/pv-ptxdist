+-		follow = ACTION_FOLLOWLINKS | ACTION_FOLLOWLINKS_L0;
++		follow |= ACTION_FOLLOWLINKS_L0 | ACTION_FOLLOWLINKS_L1;
++	if (state->depth == 1)
++		follow |= ACTION_FOLLOWLINKS_L1;
