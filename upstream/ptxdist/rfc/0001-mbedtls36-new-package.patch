From 8f120426f81f00f2984d8ce61e63aa7d8008ffde Mon Sep 17 00:00:00 2001
From: Fernando Luiz Cola <fernando.luiz@pantacor.com>
Date: Thu, 26 Nov 2026 18:01:48 -0300
Subject: [RFC PATCH 1/8] mbedtls36: new package

The mbedtls package is at 4.x, and Pantavisor and libthttp, added next,
use the 3.x API (as well as 2.28's), which 4.0 changed: the crypto
moved to TF-PSA-Crypto, with ctr_drbg, entropy, sha256 and mpi now
private and mbedtls_ssl_conf_rng() gone. Until they are ported, add
mbed TLS 3.6, the previous LTS branch, as a second package that only
its users link:

 - static libraries only, with position-independent code, and nothing
   installed on the target;
 - installed to a private sysroot prefix, /usr/lib/mbedtls-3.6, so the
   headers, libraries, pkg-config and CMake files of mbedtls 4.x stay
   untouched and both packages can be enabled at once. Users add that
   prefix to their search paths.

The options are those of the mbedtls package that 3.6 still has, with
its newer configuration options pinned empty: the default configuration.

3.6 is supported until March 2027; this package goes once its users
are on 4.x.

Signed-off-by: Fernando Luiz Cola <fernando.luiz@pantacor.com>
---
 rules/mbedtls36.in   | 14 +++++++++
 rules/mbedtls36.make | 67 ++++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 81 insertions(+)
 create mode 100644 rules/mbedtls36.in
 create mode 100644 rules/mbedtls36.make

diff --git a/rules/mbedtls36.in b/rules/mbedtls36.in
new file mode 100644
index 000000000..7da3ff971
--- /dev/null
+++ b/rules/mbedtls36.in
@@ -0,0 +1,14 @@
+## SECTION=system_libraries
+
+config MBEDTLS36
+	tristate
+	prompt "mbedtls 3.6 (static)"
+	select HOST_CMAKE
+	select LIBC_PTHREAD
+	help
+	  mbed TLS 3.6 LTS for packages that do not support the mbedtls
+	  package's 4.x API yet, such as Pantavisor and libthttp. Built
+	  as static, position independent libraries in a private sysroot
+	  prefix, /usr/lib/mbedtls-3.6, so it can coexist with the
+	  mbedtls package; nothing is installed on the target. Packages
+	  that need it add that prefix to their search paths.
diff --git a/rules/mbedtls36.make b/rules/mbedtls36.make
new file mode 100644
index 000000000..c82cf7580
--- /dev/null
+++ b/rules/mbedtls36.make
@@ -0,0 +1,67 @@
+# -*-makefile-*-
+#
+# Copyright (C) 2026 by Fernando Luiz Cola <fernando.luiz@pantacor.com>
+#
+# For further information about the PTXdist project and license conditions
+# see the README file.
+#
+
+#
+# We provide this package
+#
+PACKAGES-$(PTXCONF_MBEDTLS36) += mbedtls36
+
+#
+# Paths and names
+#
+MBEDTLS36_VERSION	:= 3.6.8
+MBEDTLS36_SHA256	:= bc54b818e87f49c0b3281dd85d24adaede0e63b4e822e3fbd49c005a38b9595b
+MBEDTLS36		:= mbedtls36-$(MBEDTLS36_VERSION)
+MBEDTLS36_SUFFIX	:= tar.bz2
+MBEDTLS36_URL		:= https://github.com/Mbed-TLS/mbedtls/releases/download/mbedtls-$(MBEDTLS36_VERSION)/mbedtls-$(MBEDTLS36_VERSION).$(MBEDTLS36_SUFFIX)
+MBEDTLS36_SOURCE	:= $(SRCDIR)/mbedtls-$(MBEDTLS36_VERSION).$(MBEDTLS36_SUFFIX)
+MBEDTLS36_DIR		:= $(BUILDDIR)/$(MBEDTLS36)
+MBEDTLS36_LICENSE	:= Apache-2.0 OR GPL-2.0-or-later
+MBEDTLS36_LICENSE_FILES	:= file://LICENSE;md5=379d5819937a6c2f1ef1630d341e026d
+
+# Relative to /usr, so the pkg-config and CMake files point here as well.
+MBEDTLS36_PREFIX	:= /usr/lib/mbedtls-3.6
+
+# ----------------------------------------------------------------------------
+# Prepare
+# ----------------------------------------------------------------------------
+
+# Static, and PIC for the libraries and plugins that link it.
+MBEDTLS36_CONF_TOOL	:= cmake
+MBEDTLS36_CONF_OPT	:= \
+	$(CROSS_CMAKE_USR) \
+	-DCMAKE_INSTALL_INCLUDEDIR=lib/mbedtls-3.6/include \
+	-DCMAKE_INSTALL_LIBDIR=lib/mbedtls-3.6/lib \
+	-DCMAKE_POSITION_INDEPENDENT_CODE=ON \
+	-DDISABLE_PACKAGE_CONFIG_AND_INSTALL=OFF \
+	-DENABLE_PROGRAMS=OFF \
+	-DENABLE_TESTING=OFF \
+	-DGEN_FILES=OFF \
+	-DINSTALL_MBEDTLS_HEADERS=ON \
+	-DLINK_WITH_PTHREAD=ON \
+	-DLINK_WITH_TRUSTED_STORAGE=OFF \
+	-DMBEDTLS_CONFIG_BASE_FILE= \
+	-DMBEDTLS_CONFIG_FILE= \
+	-DMBEDTLS_CONFIG_NAME= \
+	-DMBEDTLS_CONFIG_SET= \
+	-DMBEDTLS_CONFIG_UNSET= \
+	-DMBEDTLS_FATAL_WARNINGS=OFF \
+	-DMBEDTLS_USER_CONFIG_FILE= \
+	-DUNSAFE_BUILD=OFF \
+	-DUSE_SHARED_MBEDTLS_LIBRARY=OFF \
+	-DUSE_STATIC_MBEDTLS_LIBRARY=ON
+
+# ----------------------------------------------------------------------------
+# Target-Install
+# ----------------------------------------------------------------------------
+
+$(STATEDIR)/mbedtls36.targetinstall:
+	@$(call targetinfo)
+	@$(call touch)
+
+# vim: syntax=make
-- 
