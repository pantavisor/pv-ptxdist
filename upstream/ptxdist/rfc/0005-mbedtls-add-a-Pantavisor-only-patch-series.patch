From 09f25f2c262f45d8d641358155ed0cd8b3cc04a7 Mon Sep 17 00:00:00 2001
From: Fernando Luiz Cola <fernando.luiz@pantacor.com>
Date: Thu, 26 Nov 2026 09:32:30 -0300
Subject: [RFC PATCH 5/8] mbedtls: add a Pantavisor-only patch series

Pantavisor verifies the JWS signatures of its system revisions with
mbedtls_pk_verify(). JWS ES256 signatures are the raw R || S pair
(RFC 7518, section 3.4), while mbedtls expects an ASN.1 DER sequence and
rejects them.

The patch makes the ECDSA verify callbacks in pk_wrap.c retry a
signature that fails to parse as DER as a raw R || S pair. That relaxes
signature parsing for every mbedtls user, so it goes into
series.pantavisor, next to an empty series, and a hidden MBEDTLS_SERIES
picks it when PANTAVISOR is enabled, as for lxc, busybox and dropbear.
Other builds get stock mbedtls.

The patch comes from meta-pantavisor, where it is applied to the same
2.28.10.

Signed-off-by: Fernando Luiz Cola <fernando.luiz@pantacor.com>
---
 ...upport-validating-ANSI-X9.62-FIPS-18.patch | 255 ++++++++++++++++++
 patches/mbedtls-2.28.10/series                |   2 +
 patches/mbedtls-2.28.10/series.pantavisor     |   3 +
 rules/mbedtls.in                              |   7 +
 4 files changed, 267 insertions(+)
 create mode 100644 patches/mbedtls-2.28.10/0001-make-pk_wrap.c-support-validating-ANSI-X9.62-FIPS-18.patch
 create mode 100644 patches/mbedtls-2.28.10/series
 create mode 100644 patches/mbedtls-2.28.10/series.pantavisor

diff --git a/patches/mbedtls-2.28.10/0001-make-pk_wrap.c-support-validating-ANSI-X9.62-FIPS-18.patch b/patches/mbedtls-2.28.10/0001-make-pk_wrap.c-support-validating-ANSI-X9.62-FIPS-18.patch
new file mode 100644
index 000000000..e8a0ed6c8
--- /dev/null
+++ b/patches/mbedtls-2.28.10/0001-make-pk_wrap.c-support-validating-ANSI-X9.62-FIPS-18.patch
@@ -0,0 +1,255 @@
+From b7d907361306864cb1b17adb12458950895e2c62 Mon Sep 17 00:00:00 2001
+From: Alexander Sack <asac@pantacor.com>
+Date: Tue, 8 Feb 2022 11:58:22 +0100
+Subject: [PATCH 1/2] make pk_wrap.c support validating 'ANSI X9.62, FIPS
+ 186-4' type signatures (r,s) instead of just asn.1
+
+ - fallback in case verify failes due to ASN tag issues to (r,s)
+ - encode (r,s) in asn.1 format to keep changes minimal
+ - move helpers asn1_write_mpibuf and pk_ecdsa_sig_asn1_from_psa inside file
+
+Signed-off-by: Fernando Luiz Cola <fernando.luiz@pantacor.com>
+---
+ library/pk_wrap.c | 204 ++++++++++++++++++++++++++--------------------
+ 1 file changed, 117 insertions(+), 87 deletions(-)
+
+Index: git/library/pk_wrap.c
+===================================================================
+--- git.orig/library/pk_wrap.c
++++ git/library/pk_wrap.c
+@@ -17,6 +17,7 @@
+ #include <string.h>
+ 
+ #if defined(MBEDTLS_ECP_C)
++#include "mbedtls/asn1write.h"
+ #include "mbedtls/ecp.h"
+ #endif
+ 
+@@ -489,6 +490,88 @@ static int ecdsa_can_do(mbedtls_pk_type_
+     return type == MBEDTLS_PK_ECDSA;
+ }
+ 
++/*
++ * Simultaneously convert and move raw MPI from the beginning of a buffer
++ * to an ASN.1 MPI at the end of the buffer.
++ * See also mbedtls_asn1_write_mpi().
++ *
++ * p: pointer to the end of the output buffer
++ * start: start of the output buffer, and also of the mpi to write at the end
++ * n_len: length of the mpi to read from start
++ */
++static int asn1_write_mpibuf( unsigned char **p, unsigned char *start,
++                              size_t n_len )
++{
++    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
++    size_t len = 0;
++
++    if( (size_t)( *p - start ) < n_len )
++        return( MBEDTLS_ERR_ASN1_BUF_TOO_SMALL );
++
++    len = n_len;
++    *p -= len;
++    memmove( *p, start, len );
++
++    /* ASN.1 DER encoding requires minimal length, so skip leading 0s.
++     * Neither r nor s should be 0, but as a failsafe measure, still detect
++     * that rather than overflowing the buffer in case of a PSA error. */
++    while( len > 0 && **p == 0x00 )
++    {
++        ++(*p);
++        --len;
++    }
++
++    /* this is only reached if the signature was invalid */
++    if( len == 0 )
++        return( MBEDTLS_ERR_PK_HW_ACCEL_FAILED );
++
++    /* if the msb is 1, ASN.1 requires that we prepend a 0.
++     * Neither r nor s can be 0, so we can assume len > 0 at all times. */
++    if( **p & 0x80 )
++    {
++        if( *p - start < 1 )
++            return( MBEDTLS_ERR_ASN1_BUF_TOO_SMALL );
++
++        *--(*p) = 0x00;
++        len += 1;
++    }
++
++    MBEDTLS_ASN1_CHK_ADD( len, mbedtls_asn1_write_len( p, start, len ) );
++    MBEDTLS_ASN1_CHK_ADD( len, mbedtls_asn1_write_tag( p, start,
++                                                MBEDTLS_ASN1_INTEGER ) );
++
++    return( (int) len );
++}
++
++/* Transcode signature from PSA format to ASN.1 sequence.
++ * See ecdsa_signature_to_asn1 in ecdsa.c, but with byte buffers instead of
++ * MPIs, and in-place.
++ *
++ * [in/out] sig: the signature pre- and post-transcoding
++ * [in/out] sig_len: signature length pre- and post-transcoding
++ * [int] buf_len: the available size the in/out buffer
++ */
++static int pk_ecdsa_sig_asn1_from_psa( unsigned char *sig, size_t *sig_len,
++                                       size_t buf_len )
++{
++    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
++    size_t len = 0;
++    const size_t rs_len = *sig_len / 2;
++    unsigned char *p = sig + buf_len;
++
++    MBEDTLS_ASN1_CHK_ADD( len, asn1_write_mpibuf( &p, sig + rs_len, rs_len ) );
++    MBEDTLS_ASN1_CHK_ADD( len, asn1_write_mpibuf( &p, sig, rs_len ) );
++
++    MBEDTLS_ASN1_CHK_ADD( len, mbedtls_asn1_write_len( &p, sig, len ) );
++    MBEDTLS_ASN1_CHK_ADD( len, mbedtls_asn1_write_tag( &p, sig,
++                          MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE ) );
++
++    memmove( sig, p, len );
++    *sig_len = len;
++
++    return( 0 );
++}
++
+ #if defined(MBEDTLS_USE_PSA_CRYPTO)
+ /*
+  * An ASN.1 encoded signature is a sequence of two ASN.1 integers. Parse one of
+@@ -639,6 +722,22 @@ static int ecdsa_verify_wrap(void *ctx,
+ 
+     ret = mbedtls_ecdsa_read_signature((mbedtls_ecdsa_context *) ctx,
+                                        hash, hash_len, sig, sig_len);
++    if (ret & MBEDTLS_ERR_ECP_BAD_INPUT_DATA) {
++	    unsigned char *asnsig = malloc ((sig_len + 12) * sizeof(unsigned char));
++	    size_t asnsiglen = sig_len;
++	    memcpy (asnsig, sig, sig_len);
++	    ret = pk_ecdsa_sig_asn1_from_psa(asnsig, &asnsiglen, sig_len + 12);
++
++	    if (ret)
++		    goto leave;
++
++	    ret = mbedtls_ecdsa_read_signature(
++					       (mbedtls_ecdsa_context *) ctx,
++					       hash, hash_len, asnsig, asnsiglen);
++
++    leave:
++	    free(asnsig);
++    }
+ 
+     if (ret == MBEDTLS_ERR_ECP_SIG_LEN_MISMATCH) {
+         return MBEDTLS_ERR_PK_SIG_LEN_MISMATCH;
+@@ -671,6 +770,20 @@ static int ecdsa_verify_rs_wrap(void *ct
+         hash, hash_len, sig, sig_len,
+         (mbedtls_ecdsa_restart_ctx *) rs_ctx);
+ 
++    // if bad asn error ... we convert asn1 format and try again
++    if (ret & MBEDTLS_ERR_ECP_BAD_INPUT_DATA) {
++        sig = realloc(sig, sig_len + 5);
++        ret = pk_ecdsa_sig_asn1_from_psa(sig, &sig_len, sig_len + 5);
++
++        if (ret)
++            return ret;
++
++        ret = mbedtls_ecdsa_read_signature_restartable(
++                                                      (mbedtls_ecdsa_context *) ctx,
++                                                      hash, hash_len, sig, sig_len,
++                                                      (mbedtls_ecdsa_restart_ctx *) rs_ctx );
++    }
++
+     if (ret == MBEDTLS_ERR_ECP_SIG_LEN_MISMATCH) {
+         return MBEDTLS_ERR_PK_SIG_LEN_MISMATCH;
+     }
+@@ -925,94 +1038,6 @@ static int pk_opaque_can_do(mbedtls_pk_t
+            type == MBEDTLS_PK_ECDSA;
+ }
+ 
+-#if defined(MBEDTLS_ECDSA_C)
+-
+-/*
+- * Simultaneously convert and move raw MPI from the beginning of a buffer
+- * to an ASN.1 MPI at the end of the buffer.
+- * See also mbedtls_asn1_write_mpi().
+- *
+- * p: pointer to the end of the output buffer
+- * start: start of the output buffer, and also of the mpi to write at the end
+- * n_len: length of the mpi to read from start
+- */
+-static int asn1_write_mpibuf(unsigned char **p, unsigned char *start,
+-                             size_t n_len)
+-{
+-    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
+-    size_t len = 0;
+-
+-    if ((size_t) (*p - start) < n_len) {
+-        return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;
+-    }
+-
+-    len = n_len;
+-    *p -= len;
+-    memmove(*p, start, len);
+-
+-    /* ASN.1 DER encoding requires minimal length, so skip leading 0s.
+-     * Neither r nor s should be 0, but as a failsafe measure, still detect
+-     * that rather than overflowing the buffer in case of a PSA error. */
+-    while (len > 0 && **p == 0x00) {
+-        ++(*p);
+-        --len;
+-    }
+-
+-    /* this is only reached if the signature was invalid */
+-    if (len == 0) {
+-        return MBEDTLS_ERR_PK_HW_ACCEL_FAILED;
+-    }
+-
+-    /* if the msb is 1, ASN.1 requires that we prepend a 0.
+-     * Neither r nor s can be 0, so we can assume len > 0 at all times. */
+-    if (**p & 0x80) {
+-        if (*p - start < 1) {
+-            return MBEDTLS_ERR_ASN1_BUF_TOO_SMALL;
+-        }
+-
+-        *--(*p) = 0x00;
+-        len += 1;
+-    }
+-
+-    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(p, start, len));
+-    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(p, start,
+-                                                     MBEDTLS_ASN1_INTEGER));
+-
+-    return (int) len;
+-}
+-
+-/* Transcode signature from PSA format to ASN.1 sequence.
+- * See ecdsa_signature_to_asn1 in ecdsa.c, but with byte buffers instead of
+- * MPIs, and in-place.
+- *
+- * [in/out] sig: the signature pre- and post-transcoding
+- * [in/out] sig_len: signature length pre- and post-transcoding
+- * [int] buf_len: the available size the in/out buffer
+- */
+-static int pk_ecdsa_sig_asn1_from_psa(unsigned char *sig, size_t *sig_len,
+-                                      size_t buf_len)
+-{
+-    int ret = MBEDTLS_ERR_ERROR_CORRUPTION_DETECTED;
+-    size_t len = 0;
+-    const size_t rs_len = *sig_len / 2;
+-    unsigned char *p = sig + buf_len;
+-
+-    MBEDTLS_ASN1_CHK_ADD(len, asn1_write_mpibuf(&p, sig + rs_len, rs_len));
+-    MBEDTLS_ASN1_CHK_ADD(len, asn1_write_mpibuf(&p, sig, rs_len));
+-
+-    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_len(&p, sig, len));
+-    MBEDTLS_ASN1_CHK_ADD(len, mbedtls_asn1_write_tag(&p, sig,
+-                                                     MBEDTLS_ASN1_CONSTRUCTED |
+-                                                     MBEDTLS_ASN1_SEQUENCE));
+-
+-    memmove(sig, p, len);
+-    *sig_len = len;
+-
+-    return 0;
+-}
+-
+-#endif /* MBEDTLS_ECDSA_C */
+-
+ static int pk_opaque_sign_wrap(void *ctx, mbedtls_md_type_t md_alg,
+                                const unsigned char *hash, size_t hash_len,
+                                unsigned char *sig, size_t *sig_len,
diff --git a/patches/mbedtls-2.28.10/series b/patches/mbedtls-2.28.10/series
new file mode 100644
index 000000000..18c2caa8d
--- /dev/null
+++ b/patches/mbedtls-2.28.10/series
@@ -0,0 +1,2 @@
+# Empty on purpose: without a series file PTXdist would apply every patch
+# here. The Pantavisor patch is in series.pantavisor (MBEDTLS_SERIES).
diff --git a/patches/mbedtls-2.28.10/series.pantavisor b/patches/mbedtls-2.28.10/series.pantavisor
new file mode 100644
index 000000000..5bac7e89c
--- /dev/null
+++ b/patches/mbedtls-2.28.10/series.pantavisor
@@ -0,0 +1,3 @@
+# Selected by MBEDTLS_SERIES when PANTAVISOR is enabled. From
+# meta-pantavisor (recipes-pv/mbedtls/mbedtls/2.28.10).
+0001-make-pk_wrap.c-support-validating-ANSI-X9.62-FIPS-18.patch
diff --git a/rules/mbedtls.in b/rules/mbedtls.in
index a0d58dbd5..d1e665a48 100644
--- a/rules/mbedtls.in
+++ b/rules/mbedtls.in
@@ -11,3 +11,10 @@ config MBEDTLS
 	  for developers to include cryptographic and SSL/TLS capabilities
 	  in their (embedded) products, facilitating this functionality
 	  with a minimal coding footprint.
+
+# The Pantavisor patch is in series.pantavisor; every other build applies
+# the empty series.
+config MBEDTLS_SERIES
+	string
+	default "series.pantavisor" if PANTAVISOR
+	default "series"
-- 
