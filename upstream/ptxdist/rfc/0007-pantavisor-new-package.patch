diff --git a/rules/pantavisor.in b/rules/pantavisor.in
new file mode 100644
index 000000000..17b6db860
--- /dev/null
+++ b/rules/pantavisor.in
@@ -0,0 +1,112 @@
+## SECTION=applications
+
+menuconfig PANTAVISOR
+	tristate
+	prompt "pantavisor                    "
+	# /media is a link into /run/pantavisor (see pantavisor.make)
+	depends on !ROOTFS_MEDIA
+	select HOST_CMAKE
+	select LIBTHTTP
+	select PICOHTTPPARSER
+	select MBEDTLS
+	select LXC
+	select ZLIB
+	select LIBEVENT22
+	select LIBC_DL
+	select LIBC_PTHREAD
+	select BUSYBOX_MDEV			if RUNTIME
+	select NETCAT				if RUNTIME && PANTAVISOR_PVCONTROL
+	select E2FSPROGS			if RUNTIME
+	select E2FSPROGS_INSTALL_MKE2FS		if RUNTIME
+	select E2FSPROGS_INSTALL_MKFS_EXT4	if RUNTIME
+	select E2FSPROGS_INSTALL_E2FSCK		if RUNTIME
+	select E2FSPROGS_INSTALL_FSCK_EXT4	if RUNTIME
+	select E2FSPROGS_INSTALL_RESIZE2FS	if RUNTIME && PANTAVISOR_E2FSGROW
+	select E2FSPROGS_INSTALL_DUMPE2FS	if RUNTIME && PANTAVISOR_E2FSGROW
+	select GPTFDISK				if RUNTIME && PANTAVISOR_E2FSGROW
+	select GPTFDISK_SGDISK			if RUNTIME && PANTAVISOR_E2FSGROW
+	# sgdisk is C++; gptfdisk.in does not select the runtime
+	select GCCLIBS_CXX			if RUNTIME && PANTAVISOR_E2FSGROW
+	select CRYPTSETUP			if RUNTIME && (PANTAVISOR_DM_CRYPT || PANTAVISOR_DM_VERITY)
+	select CRYPTSETUP_VERITYSETUP		if RUNTIME && PANTAVISOR_DM_VERITY
+	select LVM2				if RUNTIME && (PANTAVISOR_DM_CRYPT || PANTAVISOR_DM_VERITY)
+	select KEYUTILS				if RUNTIME && PANTAVISOR_DM_CRYPT
+	select NFTABLES				if RUNTIME
+	help
+	  Pantavisor: container-based init and update agent for embedded
+	  Linux. Built in "embedded" mode, i.e. it runs as PID 1 from the
+	  initramfs (/init -> /usr/bin/pantavisor). Also installs the
+	  initramfs layout Pantavisor expects: /storage, /volumes,
+	  /exports and /writable, and /pv, /media and /configs as links
+	  into /run/pantavisor.
+
+if PANTAVISOR
+
+config PANTAVISOR_DEBUG
+	bool
+	prompt "debug build"
+	help
+	  Build with PANTAVISOR_DEBUG: a debug shell on the console and
+	  the debug SSH server on port 8222, plus extra logging. Not for
+	  production. The SSH server needs DROPBEAR, with DROPBEAR_GENKEYS
+	  off: Pantavisor starts it with -R.
+
+config PANTAVISOR_DM_CRYPT
+	bool
+	prompt "dm-crypt volume support"
+	help
+	  Mount encrypted (dm-crypt) volumes. Installs cryptsetup,
+	  dmsetup and keyutils.
+
+config PANTAVISOR_DM_VERITY
+	bool
+	prompt "dm-verity volume support"
+	help
+	  Mount integrity-checked (dm-verity) volumes and turn on the
+	  secure boot handlers (PV_SECUREBOOT_HANDLERS) that check them.
+	  Installs cryptsetup's veritysetup and dmsetup.
+
+config PANTAVISOR_E2FSGROW
+	bool
+	prompt "grow storage partition on first boot"
+	default y
+	help
+	  Grow the storage partition and its ext4 file system to the end
+	  of the disk on first boot. pv_e2fsgrow uses busybox fdisk on
+	  MBR disks and sgdisk on GPT disks.
+
+config PANTAVISOR_PVCONTROL
+	bool
+	prompt "install pvcontrol and pvcurl"
+	default y
+	help
+	  pvcontrol is the command line client for Pantavisor's local
+	  control socket (status, metadata, updates); pvcurl is the
+	  small HTTP-over-Unix-socket client it uses.
+
+config PANTAVISOR_PVTX
+	bool
+	prompt "install pvtx"
+	default y
+	help
+	  pvtx creates, modifies and installs revisions locally through
+	  the control socket, with atomic commit and rollback. Also
+	  installs libpvtx.
+
+config PANTAVISOR_XCONNECT
+	bool
+	prompt "build pv-xconnect"
+	help
+	  pv-xconnect mediates services between containers: providers
+	  declare what they expose, consumers what they need, and
+	  Pantavisor injects the resources into the consumer.
+
+config PANTAVISOR_DEBUG_HOOKS
+	bool
+	prompt "install debug system hooks"
+	depends on PANTAVISOR_DEBUG
+	help
+	  Install a system hook that runs per-revision debug
+	  configuration from the storage, for testing hooks.
+
+endif
diff --git a/rules/pantavisor.make b/rules/pantavisor.make
new file mode 100644
index 000000000..9552c6c9d
--- /dev/null
+++ b/rules/pantavisor.make
@@ -0,0 +1,151 @@
+# -*-makefile-*-
+#
+# Copyright (C) 2026 by Fernando Luiz Cola <fernando.luiz@pantacor.com>
+#
+# For further information about the PTXdist project and license conditions
+# see the README file.
+#
+
+#
+# We provide this package
+#
+PACKAGES-$(PTXCONF_PANTAVISOR) += pantavisor
+
+#
+# Paths and names
+#
+PANTAVISOR_VERSION	:= 031
+PANTAVISOR_SHA256	:= ec0785e36ca53931bc6dd0c8316ffbe43017ec0e4c85e53d5a437f87b97c53a6
+PANTAVISOR		:= pantavisor-$(PANTAVISOR_VERSION)
+PANTAVISOR_SUFFIX	:= tar.gz
+PANTAVISOR_URL		:= git+https://github.com/pantavisor/pantavisor.git;tag=$(PANTAVISOR_VERSION)
+PANTAVISOR_SOURCE	:= $(SRCDIR)/$(PANTAVISOR).$(PANTAVISOR_SUFFIX)
+PANTAVISOR_DIR		:= $(BUILDDIR)/$(PANTAVISOR)
+PANTAVISOR_LICENSE	:= MIT
+PANTAVISOR_LICENSE_FILES := \
+	file://LICENSE;md5=9537d669f1ccfd74f3940b3bc1d3297d
+
+# ----------------------------------------------------------------------------
+# Prepare
+# ----------------------------------------------------------------------------
+
+# libevent22's private prefix (LIBEVENT22_PREFIX), spelled out because
+# rule files are not included in a fixed order. CMAKE_PREFIX_PATH makes
+# find_library() take its static libs before a libevent 2.1 in /usr/lib.
+PANTAVISOR_LIBEVENT_PREFIX := /usr/lib/libevent-2.2
+PANTAVISOR_CPPFLAGS	:= -I$(PTXDIST_SYSROOT_TARGET)$(PANTAVISOR_LIBEVENT_PREFIX)/include
+
+PANTAVISOR_CONF_TOOL	:= cmake
+PANTAVISOR_CONF_OPT	:= \
+	$(CROSS_CMAKE_USR) \
+	-DCMAKE_PREFIX_PATH=$(PANTAVISOR_LIBEVENT_PREFIX) \
+	-DPANTAVISOR_APPENGINE=OFF \
+	-DPANTAVISOR_CLANG_FORMAT_CHECK=OFF \
+	-DPANTAVISOR_DCP_BLOB_CREATE=OFF \
+	-DPANTAVISOR_DEBUG=$(call ptx/onoff, PTXCONF_PANTAVISOR_DEBUG) \
+	-DPANTAVISOR_DEBUG_HOOKS=$(call ptx/onoff, PTXCONF_PANTAVISOR_DEBUG_HOOKS) \
+	-DPANTAVISOR_DEFAULTS_SKIP_INSTALL=OFF \
+	-DPANTAVISOR_DISTRO_NAME=ptxdist \
+	-DPANTAVISOR_DISTRO_VERSION=$(PTXDIST_VERSION_FULL) \
+	-DPANTAVISOR_DM_CRYPT=$(call ptx/onoff, PTXCONF_PANTAVISOR_DM_CRYPT) \
+	-DPANTAVISOR_DM_VERITY=$(call ptx/onoff, PTXCONF_PANTAVISOR_DM_VERITY) \
+	-DPANTAVISOR_E2FSGROW_ENABLE=$(call ptx/onoff, PTXCONF_PANTAVISOR_E2FSGROW) \
+	-DPANTAVISOR_PVCONTROL=$(call ptx/onoff, PTXCONF_PANTAVISOR_PVCONTROL) \
+	-DPANTAVISOR_PVS_SKIP_INSTALL=ON \
+	-DPANTAVISOR_PVTEST=OFF \
+	-DPANTAVISOR_PVTX=$(call ptx/onoff, PTXCONF_PANTAVISOR_PVTX) \
+	-DPANTAVISOR_PVTX_STATIC=OFF \
+	-DPANTAVISOR_PVZRAM_TEST=OFF \
+	-DPANTAVISOR_RUNTIME=ON \
+	-DPANTAVISOR_XCONNECT=$(call ptx/onoff, PTXCONF_PANTAVISOR_XCONNECT) \
+	-DPANTAVISOR_XCONNECT_DBUS_SYSTEMBUS=OFF
+
+# Consumed by gen_version.sh (see patches/pantavisor-031).
+PANTAVISOR_MAKE_ENV	:= \
+	PV_GIT_DESCRIBE=$(PANTAVISOR_VERSION)
+
+# GCC 15 defaults to C23, where old-style 'void f();' prototypes mean "no
+# arguments" (e.g. pv_storage_set_active() in 030); pvtx already pins C17.
+# The rest are the relaxations meta-pantavisor needs (OECMAKE_C_FLAGS), as the
+# project builds with -Werror.
+PANTAVISOR_CFLAGS	:= \
+	-std=gnu17 \
+	-Wno-unused-result \
+	-Wno-error=implicit-function-declaration
+
+# ----------------------------------------------------------------------------
+# Install
+# ----------------------------------------------------------------------------
+
+# Since 031, the shipped config turns the secure boot handlers on, and with
+# them dm-verity checks of dm: volumes. Follow PANTAVISOR_DM_VERITY instead,
+# like meta-pantavisor does.
+# The shipped config sets no cgroup version, which means v1 in embedded
+# mode. With lxc 6, let Pantavisor pick: v2 when the kernel has cgroup BPF.
+#
+# Pantavisor keeps its containers in $PV_SYSTEM_USRDIR/var/lib/lxc
+# (/usr/var/lib/lxc), and fallbear-cmd runs lxc-info and lxc-console without
+# -P. lxc.conf makes that liblxc's default lxcpath; stock lxc's is
+# /var/lib/lxc.
+$(STATEDIR)/pantavisor.install:
+	@$(call targetinfo)
+	@$(call world/install, PANTAVISOR)
+	@sed -i 's/^PV_SECUREBOOT_HANDLERS=.*/PV_SECUREBOOT_HANDLERS=$(call ptx/ifdef, PTXCONF_PANTAVISOR_DM_VERITY,1,0)/' \
+		$(PANTAVISOR_PKGDIR)/etc/pantavisor.config
+	@sed -i '/^PV_SYSTEM_CGROUP_VERSION=/d' $(PANTAVISOR_PKGDIR)/etc/pantavisor.config
+	@echo 'PV_SYSTEM_CGROUP_VERSION=auto' >> \
+		$(PANTAVISOR_PKGDIR)/etc/pantavisor.config
+	@mkdir -p $(PANTAVISOR_PKGDIR)/etc/lxc
+	@echo 'lxc.lxcpath = /usr/var/lib/lxc' > $(PANTAVISOR_PKGDIR)/etc/lxc/lxc.conf
+	@$(call touch)
+
+# ----------------------------------------------------------------------------
+# Target-Install
+# ----------------------------------------------------------------------------
+
+$(STATEDIR)/pantavisor.targetinstall:
+	@$(call targetinfo)
+
+	@$(call install_init, pantavisor)
+	@$(call install_fixup, pantavisor,PRIORITY,optional)
+	@$(call install_fixup, pantavisor,SECTION,base)
+	@$(call install_fixup, pantavisor,AUTHOR,"Fernando Luiz Cola <fernando.luiz@pantacor.com>")
+	@$(call install_fixup, pantavisor,DESCRIPTION,"Pantavisor container init and update agent")
+
+	@$(call install_copy, pantavisor, 0, 0, 0755, -, /usr/bin/pantavisor)
+	@$(call install_link, pantavisor, usr/bin/pantavisor, /init)
+
+	@$(call install_copy, pantavisor, 0, 0, 0644, -, /usr/lib/pantavisor/pv_lxc.so)
