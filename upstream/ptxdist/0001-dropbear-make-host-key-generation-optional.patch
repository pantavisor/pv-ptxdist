From d885032b200c749a45d5e53374837fa60a815eb2 Mon Sep 17 00:00:00 2001
From: Fernando Luiz Cola <fernando.luiz@pantacor.com>
Date: Tue, 24 Nov 2026 14:55:32 -0300
Subject: [PATCH] dropbear: make host key generation optional

dropbear always installs /etc/rc.once.d/dropbear, which creates the
host keys on the first boot, and selects INITMETHOD and RC_ONCE for it.
Some systems do not want that: dropbear started with -R creates
missing host keys on the first connection, and a system whose init is
not one of PTXdist's init methods, such as an initramfs with its own
PID 1, still gets the default INITMETHOD (systemd) because of dropbear.

Add DROPBEAR_GENKEYS, default y so nothing changes for existing
configurations. It installs the script and selects INITMETHOD and
RC_ONCE. The postinst only enables the rc-once script if it is
installed, as openssh's does; before, it did so even with
DROPBEAR_DROPBEAR_KEY disabled, when the script was missing.

Signed-off-by: Fernando Luiz Cola <fernando.luiz@pantacor.com>
---
Tested on an aarch64 BSP that starts dropbear with -R and has no
INITMETHOD: with DROPBEAR_GENKEYS disabled, the package installs
dropbearkey but not /etc/rc.once.d/dropbear, INITMETHOD and RC_ONCE
stay unset, and dropbear creates its host key on the first connection.
The default (enabled) installs and selects the same as before.

 rules/dropbear.in       | 15 +++++++++++++--
 rules/dropbear.make     |  2 ++
 rules/dropbear.postinst |  4 +++-
 3 files changed, 18 insertions(+), 3 deletions(-)

diff --git a/rules/dropbear.in b/rules/dropbear.in
index 95beb09bf..ca4640682 100644
--- a/rules/dropbear.in
+++ b/rules/dropbear.in
@@ -6,8 +6,8 @@ menuconfig DROPBEAR
 	select LIBC_UTIL
 	select LIBC_CRYPT
 	select GCCLIBS_GCC_S
-	select INITMETHOD
-	select RC_ONCE						if RUNTIME
+	select INITMETHOD					if DROPBEAR_GENKEYS
+	select RC_ONCE						if DROPBEAR_GENKEYS && RUNTIME
 	select BUSYBOX_START_STOP_DAEMON			if DROPBEAR_STARTSCRIPT
 	select BUSYBOX_FEATURE_START_STOP_DAEMON_FANCY		if DROPBEAR_STARTSCRIPT
 	select BUSYBOX_FEATURE_START_STOP_DAEMON_LONG_OPTIONS	if DROPBEAR_STARTSCRIPT
@@ -425,6 +425,17 @@ comment "OpenSSH scp is selected!"
 
 comment "Runtime options                ---"
 
+config DROPBEAR_GENKEYS
+	bool
+	default y
+	depends on DROPBEAR_DROPBEAR_KEY
+	prompt "generate host keys on first boot"
+	help
+	  Install /etc/rc.once.d/dropbear, which creates the host keys
+	  with dropbearkey on the first boot. Disable it when dropbear is
+	  started with -R, which creates missing host keys on the first
+	  connection, or when the system has no init method of its own.
+
 config DROPBEAR_STARTSCRIPT
 	bool
 	default y
diff --git a/rules/dropbear.make b/rules/dropbear.make
index eb720532d..96e5f755b 100644
--- a/rules/dropbear.make
+++ b/rules/dropbear.make
@@ -336,7 +336,9 @@ endif
 ifdef PTXCONF_DROPBEAR_DROPBEAR_KEY
 	@$(call install_copy, dropbear, 0, 0, 0755, -, \
 		/usr/bin/dropbearkey)
+endif
 
+ifdef PTXCONF_DROPBEAR_GENKEYS
 	@$(call install_alternative, dropbear, 0, 0, 0755, /etc/rc.once.d/dropbear, n)
 endif
 
diff --git a/rules/dropbear.postinst b/rules/dropbear.postinst
index 6150f6018..0b821d9b0 100644
--- a/rules/dropbear.postinst
+++ b/rules/dropbear.postinst
@@ -1,2 +1,4 @@
 #!/bin/sh
-$DESTDIR/usr/sbin/enable-rc-once dropbear
+if [ -f $DESTDIR/etc/rc.once.d/dropbear ]; then
+	$DESTDIR/usr/sbin/enable-rc-once dropbear
+fi
-- 
2.43.0

