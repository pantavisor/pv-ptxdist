## SECTION=pantavisor

menuconfig PANTAVISOR
	tristate
	prompt "pantavisor                    "
	select HOST_CMAKE
	select LIBTHTTP
	select PICOHTTPPARSER
	select MBEDTLS
	select LXC				if PANTAVISOR_LXC_STABLE
	select LXC_PV				if PANTAVISOR_LXC_DEPRECATED
	select ZLIB
	select LIBEVENT22
	select LIBC_DL
	select LIBC_PTHREAD
	select BUSYBOX_MDEV			if RUNTIME
	select NETCAT				if RUNTIME && PANTAVISOR_PVCONTROL
	select E2FSPROGS			if RUNTIME
	select E2FSPROGS_INSTALL_MKE2FS		if RUNTIME
	select E2FSPROGS_INSTALL_MKFS_EXT4	if RUNTIME
	select E2FSPROGS_INSTALL_E2FSCK		if RUNTIME
	select E2FSPROGS_INSTALL_FSCK_EXT4	if RUNTIME
	select E2FSPROGS_INSTALL_RESIZE2FS	if RUNTIME && PANTAVISOR_E2FSGROW
	select E2FSPROGS_INSTALL_DUMPE2FS	if RUNTIME && PANTAVISOR_E2FSGROW
	select GPTFDISK				if RUNTIME && PANTAVISOR_E2FSGROW
	select GPTFDISK_SGDISK			if RUNTIME && PANTAVISOR_E2FSGROW
	# sgdisk is C++; gptfdisk.in does not select the runtime
	select GCCLIBS_CXX			if RUNTIME && PANTAVISOR_E2FSGROW
	select CRYPTSETUP			if RUNTIME && (PANTAVISOR_DM_CRYPT || PANTAVISOR_DM_VERITY)
	select CRYPTSETUP_VERITYSETUP		if RUNTIME && PANTAVISOR_DM_VERITY
	select LVM2				if RUNTIME && (PANTAVISOR_DM_CRYPT || PANTAVISOR_DM_VERITY)
	select KEYUTILS				if RUNTIME && PANTAVISOR_DM_CRYPT
	select NFTABLES				if RUNTIME
	help
	  Pantavisor: container-based init and update agent for embedded
	  Linux. Built in "embedded" mode, i.e. it runs as PID 1 from the
	  initramfs (/init -> /usr/bin/pantavisor).

if PANTAVISOR

choice
	prompt "LXC runtime"
	default PANTAVISOR_LXC_STABLE

config PANTAVISOR_LXC_STABLE
	bool
	prompt "LXC 6"
	help
	  LXC 6.0 LTS with the Pantavisor patches (series.pantavisor). Pantavisor picks the
	  cgroup version itself (PV_SYSTEM_CGROUP_VERSION=auto): cgroup
	  v2 when the kernel has cgroup BPF, v1 otherwise.

config PANTAVISOR_LXC_DEPRECATED
	bool
	prompt "LXC 3 (lxc-pv, deprecated)"
	help
	  The old LXC 3.0 fork, for systems that still need it. It only
	  supports cgroup v1, so Pantavisor is set to
	  PV_SYSTEM_CGROUP_VERSION=1.

endchoice

config PANTAVISOR_DEBUG
	bool
	prompt "debug build"
	help
	  Build with PANTAVISOR_DEBUG: a debug shell on the console and
	  the debug SSH server (dropbear) on port 8222, plus extra
	  logging. Not for production.

config PANTAVISOR_DEVELOPER_TRUST
	bool
	default y
	prompt "install the developer trust store"
	help
	  Install the "Pantavisor Dev CA" certificate to
	  /etc/pantavisor/pvs/trust. Pantavisor then accepts revisions
	  signed with the development keys published for pvr
	  (pvs.defaultkeys.tar.gz), which anyone can use. Not for
	  production: disable it and install your own trust store in
	  /etc/pantavisor/pvs, e.g. from projectroot.

config PANTAVISOR_DM_CRYPT
	bool
	prompt "dm-crypt volume support"
	help
	  Mount encrypted (dm-crypt) volumes. Installs cryptsetup,
	  dmsetup and keyutils.

config PANTAVISOR_DM_VERITY
	bool
	prompt "dm-verity volume support"
	help
	  Mount integrity-checked (dm-verity) volumes and turn on the
	  secure boot handlers (PV_SECUREBOOT_HANDLERS) that check them.
	  Installs cryptsetup's veritysetup and dmsetup.

config PANTAVISOR_E2FSGROW
	bool
	prompt "grow storage partition on first boot"
	default y
	help
	  Grow the storage partition and its ext4 file system to the end
	  of the disk on first boot. pv_e2fsgrow uses busybox fdisk on
	  MBR disks and sgdisk on GPT disks.

config PANTAVISOR_PVCONTROL
	bool
	prompt "install pvcontrol and pvcurl"
	default y
	help
	  pvcontrol is the command line client for Pantavisor's local
	  control socket (status, metadata, updates); pvcurl is the
	  small HTTP-over-Unix-socket client it uses.

config PANTAVISOR_PVTX
	bool
	prompt "install pvtx"
	default y
	help
	  pvtx creates, modifies and installs revisions locally through
	  the control socket, with atomic commit and rollback. Also
	  installs libpvtx.

config PANTAVISOR_XCONNECT
	bool
	prompt "build pv-xconnect"
	help
	  pv-xconnect mediates services between containers: providers
	  declare what they expose, consumers what they need, and
	  Pantavisor injects the resources into the consumer.

config PANTAVISOR_DEBUG_HOOKS
	bool
	prompt "install debug system hooks"
	depends on PANTAVISOR_DEBUG
	help
	  Install a system hook that runs per-revision debug
	  configuration from the storage, for testing hooks.

endif
